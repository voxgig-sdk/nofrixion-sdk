              lit: "card"
            }
            {
              lit: "refund"
            }
            {
              var: "partial_refund_amount"
            }
          ]
          select: {
            exist: [
              "partial_refund_amount"
              "paymentrequest_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
