          contract: {
            id: "GET /api/v1/payruns"
            json: "{\"operationId\":\"GetPayrunsPaged\",\"parameters\":[{\"description\":\"The merchant ID to get the payruns for\",\"in\":\"query\",\"name\":\"merchantID\",\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The page number from where records are retrieved.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of records to be retrieved from a page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The date filter to apply to retrieve payruns created after this date.\",\"in\":\"query\",\"name\":\"fromDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The date filter to apply to retrieve payruns created up until this date.\",\"in\":\"query\",\"name\":\"toDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Optional expression to sort the order of the payruns.\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"description\":\"An optional status filter list\",\"in\":\"query\",\"name\":\"statuses\",\"schema\":{\"items\":{\"enum\":[\"None\",\"Draft\",\"Submitted\",\"Completed\",\"Rejected\",\"AuthorisationPending\",\"PayoutsCreated\",\"Queued\",\"Approving\",\"Processing\"],\"type\":\"string\"},\"type\":\"array\"}},{\"description\":\"The text filter to apply to retrieve payruns\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Flag that indicates whether to fetch only archived payruns or not\",\"in\":\"query\",\"name\":\"onlyArchived\",\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"authorisationDate\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"authorisations\":{\"description\":\"A list of the users who have successfully authorised the latest version of the payrun and when.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"authorisersCompletedCount\":{\"description\":\"The number of distinct authorisers that have authorised the payrun.\",\"format\":\"int32\",\"type\":\"integer\"},\"authorisersRequiredCount\":{\"description\":\"The number of authorisers required for this payrun. Is determined by business settings\\r\\non the source account and/or merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"batchPayoutID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"canAuthorise\":{\"description\":\"True if the payrun can be authorised by the user who loaded it.\",\"type\":\"boolean\"},\"canDelete\":{\"readOnly\":true,\"type\":\"boolean\"},\"canEdit\":{\"readOnly\":true,\"type\":\"boolean\"},\"events\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"notes\":{\"nullable\":true,\"type\":\"string\"},\"timeStamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"type\":{\"enum\":[\"None\",\"Created\",\"Submitted\",\"Rejected\",\"Edited\",\"AuthorisationRequested\",\"Completed\",\"Approved\",\"TopupInitiated\",\"FundsArrived\",\"Archived\",\"Una