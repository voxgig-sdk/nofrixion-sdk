ut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"documents\":{\"description\":\"Documents associated with the payout.\",\"items\":{\"additionalProperties\":false,\"description\":\"Used for returning a payout document.\",\"properties\":{\"amount\":{\"description\":\"Amount of the document, if applicable. Optional.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"currency\":{\"description\":\"Currency of the document, if applicable. Optional.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"Additional information about the document. Optional.\",\"maxLength\":256,\"nullable\":true,\"type\":\"string\"},\"documentType\":{\"description\":\"Type of the document.\",\"enum\":[\"Other\",\"Invoice\",\"PurchaseOrder\"],\"type\":\"string\"},\"externalID\":{\"description\":\"Allows to associate an external ID to the document. Optional.\",\"maxLength\":128,\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Internal ID of the document.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Date of insertion.\",\"format\":\"date-time\",\"type\":\"string\"},\"title\":{\"description\":\"Used to identify the document.