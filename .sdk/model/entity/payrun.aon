            id: "POST /api/v1/payruns/{merchantID}"
            json: "{\"operationId\":\"CreatePayrun\",\"parameters\":[{\"description\":\"The merchant ID to create the Payrun for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"invoices\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"contact\":{\"description\":\"Supplier's name\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency used in the invoice.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"date\":{\"description\":\"Date the invoice was issued.\",\"format\":\"date-time\",\"type\":\"string\"},\"destination\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"An optional ID of an internal account the counterparty is associated with. If set\\r\\nit will take precedence over any other destination details set for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"description\":\"Address line 1 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"addressLine2\":{\"description\":\"Address line 2 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"beneficiaryID\":{\"description\":\"Optional ID of a Beneficiary to use for the counterparty destination. If set\\r\\nit will take precedence over any other destination details, except for AccountID,\\r\\nset for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"A country code for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"An email address for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"internalAccountName\":{\"description\":\"If the counterparty is an internal account, this is the name of the account.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"payeeVerificationResult\":{\"additionalProperties\":false,\"properties\":{\"payeeVerifiedAccountName\":{\"description\":\"The verified account name of the payee, if available (in case of a close match)\",\"nullable\":true,\"type\":\"string\"},\"result\":{\"description\":\"The result of the payee verification\",\"enum\":[\"Unknown\",\"Match\",\"NoMatch\",\"CloseMatch\"],\"type\":\"string\"}},\"type\":\"object\"},\"payeeVerificationStatus\":{\"description\":\"Current status of the payee verification check\",\"enum\":[\"None\",\"NotRequired\",\"Pending\",\"Completed\",\"Failed\",\"TimedOut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"discounts\":{\"description\":\"Optional. Any discounts applied to the invoice.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"dueDate\":{\"description\":\"Date by which payment is due.\",\"format\":\"date-time\",\"type\":\"string\"},\"externalInvoiceID\":{\"description\":\"If this invoice was created from an external invoice, this will be the ID of the external invoice.\",\"nullable\":true,\"type\":\"string\"},\"externalInvoiceProvider\":{\"description\":\"If this invoice was created from an external invoice, this will be the provider of the external invoice.\\r\\nE.g., \\\"Xero\\\", \\\"QuickBooks\\\", etc.\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"invoicePayments\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"invoiceID\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"payoutID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"invoiceReference\":{\"minLength\":1,\"type\":\"string\"},\"isEnabled\":{\"type\":\"boolean\"},\"name\":{\"description\":\"Optional. The name of the invoice.\",\"nullable\":true,\"type\":\"string\"},\"outstandingAmount\":{\"description\":\"The amount that is still outstanding for this invoice.\",\"format\":\"double\",\"type\":\"number\"},\"payRunID\":{\"description\":\"The ID of the pay run this invoice belongs to.\",\"format\":\"uuid\",\"type\":\"string\"},\"paymentReference\":{\"description\":\"The reference sent to the recipient's bank. If left empty,\\r\\nan autogenerated reference will be used instead.\",\"nullable\":true,\"type\":\"string\"},\"paymentTerms\":{\"description\":\"Optional additional information about the invoice.\",\"nullable\":true,\"type\":\"string\"},\"remittanceEmail\":{\"description\":\"Email address to which a remittance note will be sent, if specified.\",\"format\":\"email\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"nullable\":true,\"type\":\"string\"},\"subTotal\":{\"description\":\"Optional. The total amount before discounts and taxes.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"taxes\":{\"description\":\"Optional. The total amount of taxes applied to the invoice.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"totalAmount\":{\"description\":\"Final total amount of the invoice, including discounts and taxes.\",\"format\":\"double\",\"type\":\"number\"},\"xeroInvoiceID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"currency\",\"invoiceReference\",\"totalAmount\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"The properties, including the list of invocies, for the PayRun.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authorisationDate\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"authorisations\":{\"description\":\"A list of the users who have successfully authorised the latest version of the payrun and when.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"authorisersCompletedCount\":{\"description\":\"The number of distinct authorisers that have authorised the payrun.\",\"format\":\"int32\",\"type\":\"integer\"},\"authorisersRequiredCount\":{\"description\":\"The number of authorisers required for this payrun. Is determined by business settings\\r\\non the source account and/or merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"batchPayoutID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"canAuthorise\":{\"description\":\"True if the payrun can be authorised by the user who loaded it.\",\"type\":\"boolean\"},\"canDelete\":{\"readOnly\":true,\"type\":\"boolean\"},\"canEdit\":{\"readOnly\":true,\"type\":\"boolean\"},\"events\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"notes\":{\"nullable\":true