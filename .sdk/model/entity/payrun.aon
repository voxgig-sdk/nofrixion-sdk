eName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"},\"createdByDisplayName\":{\"description\":\"Either the name of the user, merchant token or api key that created the account\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of the account in ISO 4217 format\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"defaultPaymentRail\":{\"description\":\"Indicates the default payment rail for this account. Normally it will be left as the\\r\\ndefault value but in some special cases it may be set to indicate payouts from this account\\r\\nshould be attempted with a specific payment rail.\",\"enum\":[\"Default\",\"SEPA_CT\",\"SEPA_INST\",\"TARGET2\"],\"type\":\"string\"},\"displayName\":{\"description\":\"Gets a unique display name for the payment account. Useful for when payment accounts need to \\r\\nbe listed.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"expiryDate\":{\"description\":\"The date that the external account will expire\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"externalAccountIcon\":{\"description\":\"The Icon for external accounts\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Unique id for the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"inserted\":{\"description\":\"Timestamp when the account was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the account is archived. Archived accounts are not displayed in the UI.\\r\\nIf an account receives a payment it will be automatically unarchived.\",\"type\":\"boolean\"},\"isConnectedAccount\":{\"description\":\"Indicates if the payment account is an externally connected account.\\r\\nExternally connected account can be used to view account balances and transactions.\",\"type\":\"boolean\"},\"isDefault\":{\"description\":\"Is the default account\",\"type\":\"boolean\"},\"isTrustAccount\":{\"description\":\"Indicates if the payment account is a trust account. The account name is displayed in the statement\\r\\ninstead of the merchant name for trust accounts.\",\"type\":\"boolean\"},\"isVirtual\":{\"description\":\"True if the account is a virtual account.\",\"readOnly\":true,\"type\":\"boolean\"},\"lastTransaction\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"date\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"lastUpdated\":{\"description\":\"Timestamp when the account was last updated.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"merchantName\":{\"description\":\"The name of the merchant that owns the account.\",\"nullable\":true,\"type\":\"string\"},\"physicalAccountID\":{\"description\":\"For virtual accounts this is the ID of the physical account that the virtual account is linked to.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"rules\":{\"description\":\"The list of rules associated with this account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"submittedPayoutsBalance\":{\"description\":\"Total of the payouts that have been submitted for processing.\",\"format\":\"double\",\"type\":\"number\"},\"submittedPayoutsBalanceMinorUnits\":{\"description\":\"The balance of the submitted payouts expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"summary\":{\"description\":\"Gets a summary of the payments account's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"supplierSepaInstantStatus\":{\"description\":\"Indicates the status of the SEPA Instant payment rail for this account.\",\"enum\":[\"None\",\"Pending\",\"InProgress\",\"Enabled\",\"Disabled\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedConnectionStatus\":{\"description\":\"States the status of the Xero bank feed connection, if applicable.\",\"enum\":[\"None\",\"Pending\",\"Active\",\"Inactive\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedLastSyncedAt\":{\"f