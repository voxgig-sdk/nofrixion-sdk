on\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"},\"createdByDisplayName\":{\"description\":\"Either the name of the user, merchant token or api key that created the account\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of the account in ISO 4217 format\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"defaultPaymentRail\":{\"description\":\"Indicates the default payment rail for this account. Normally it will be left as the\\r\\ndefault value but in some special cases it may be set to indicate payouts from this account\\r\\nshould be attempted with a specific payment rail.\",\"enum\":[\"Default\",\"SEPA_CT\",\"SEPA_INST\",\"TARGET2\"],\"type\":\"string\"},\"displayName\":{\"description\":\"Gets a unique display name for the payment account. Useful for when payment accounts need to \\r\\nbe listed.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"expiryDate\":{\"description\":\"The date that the external account will expire\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"externalAccountIcon\":{\"description\":\"The Icon for external accounts\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Unique id for the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},