{\"description\":\"The payment account supplier name. A payment account can be supplied by multiple payment processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"availableBalance\":{\"description\":\"The current available balance of the account. Calculated by subtracting any submitted payments from the current balance.\",\"format\":\"double\",\"readOnly\":true,\"type\":\"number\"},\"availableBalanceMinorUnits\":{\"description\":\"The available balance expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance of the account.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance of the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"bankName\":{\"description\":\"The bank name for external accounts\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the consent used to connect the external account.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"createdBy\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"},\"createdByDisplayName\":{\"description\":\"Either the name of the user, merchant token or api key that created the account\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of the account in ISO 4217 format\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"defaultPaymentRail\":{\"description\":\"Indicates the default payment rail for this account. Normally it will be left as the\\r\\ndefault value but in some special cases it may be set to indicate payouts from this account\\r\\nshould be attempted with a specific payment rail.\",\"enum\":[\"Default\",\"SEPA_CT\",\"SEPA_INST\",\"TARGET2\"],\"type\":\"string\"},\"displayName\":{\"description\":\"Gets a unique display name for the payment account. Useful for when payment accounts need to \\r\\nbe listed.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"expiryDate\":{\"description\":\"The date that the external account will expire\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"externalAccountIcon\":{\"description\":\"The Icon for external accounts\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Unique id for the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"inserted\":{\"description\":\"Timestamp when the account was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the account is archived. Archived accounts are not displayed in the UI.\\r\\nIf an account receives a payment it will be automatically unarchived.\",\"type\":\"boolean\"},\"isConnectedAccount\":{\"description\":\"Indicates if the payment account is an externally connected account.\\r\\nExternally connected account can be used to view account balances and transactions.\",\"type\":\"boolean\"},\"isDefault\":{\"description\":\"Is the default account\",\"type\":\"boolean\"},\"isTrustAccount\":{\"description\":\"Indicates if the payment account is a trust account. The account name is displayed in the statement\\r\\ninstead of the merchant name for trust accounts.\",\"type\":\"boolean\"},\"isVirtual\":{\"description\":\"True if the account is a virtual account.\",\"readOnly\":true,\"type\":\"boolean\"},\"lastTransaction\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"date\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"lastUpdated\":{\"description\":\"Timestamp when the account was last updated.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"merchantName\":{\"description\":\"The name of the merchant that owns the account.\",\"nullable\":true,\"type\":\"string\"},\"physicalAccountID\":{\"description\":\"For virtual accounts this is the ID of the physical account that the virtual account is linked to.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"rules\":{\"description\":\"The list of rules associated with this account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"submittedPayoutsBalance\":{\"description\":\"Total of the payouts that have been submitted for processing.\",\"format\":\"double\",\"type\":\"number\"},\"submittedPayoutsBalanceMinorUnits\":{\"description\":\"The balance of the submitted payouts expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"summary\":{\"description\":\"Gets a summary of the payments account's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"supplierSepaInstantStatus\":{\"description\":\"Indicates the status of the SEPA Instant payment rail for this account.\",\"enum\":[\"None\",\"Pending\",\"InProgress\",\"Enabled\",\"Disabled\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedConnectionStatus\":{\"description\":\"States the status of the Xero bank feed connection, if applicable.\",\"enum\":[\"None\",\"Pending\",\"Active\",\"Inactive\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedLastSyncedAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncLastFailedAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncLastFailureReason\":{\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncStatus\":{\"enum\":[\"None\",\"InProgress\",\"Completed\",\"Failed\"],\"type\":\"string\"},\"xeroUnsynchronisedTransactionsCount\":{\"description\":\"Indicates the number of unsynchronised transactions with Xero\",\"format\":\"int32\",\"nullable\":true,\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"theirReference\":{\"description\":\"The reference that will be used by default as TheirReference when creating payouts to this beneficiary\\r\\nif no TheirReference is specified for the payout.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"currency\",\"name\"],\"type\":\"object\"},\"canAuthorise\":{\"description\":\"True if the payout can be authorised by the user who loaded it.\",\"type\":\"boolean\"},\"canProcess\":{\"description\":\"If set to true indicates the payout has been flagged as safe to process after transaction monitoring.\",\"type\":\"boolean\"},\"canUpdate\":{\"description\":\"True if the payout can be updated by the user who loaded it.\",\"type\":\"boolean\"},\"chargeBearer\":{\"description\":\"Optional field to set who should pay any fees for the payout. Typically only\\r\\nused for international payments and ignored for SEPA and Faster Payments.\",\"enum\":[\"Default\",\"BEN\",\"OUR\",\"SHA\"],\"type\":\"string\"},\"createdBy\":{\"nullable\":true,\"type\":\"string\"},\"createdByEmailAddress\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Gets or Sets Currency of payout request\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"currentUserID\":{\"description\":\"The ID of the user that requested access to the PayOut record. Note\\r\\nthis is NOT necessarily the user that created it.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"Gets or Sets description of payout request\",\"nullable\":true,\"type\":\"string\"},\"destination\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"An optional ID of an internal account the counterparty is associated with. If set\\r\\nit will take precedence over any other destination details set for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"description\":\"Address line 1 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"addressLine2\":{\"description\":\"Address line 2 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"beneficiaryID\":{\"description\":\"Optional ID of a Beneficiary to use for the counterparty destination. If set\\r\\nit will take precedence over any other destination details, except for AccountID,\\r\\nset for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"A country code for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"An email address for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"internalAccountName\":{\"description\":\"If the counterparty is an internal account, this is the name of the account.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"payeeVerificationResult\":{\"additionalProperties\":false,\"properties\":{\"payeeVerifiedAccountName\":{\"description\":\"The verified account name of the payee, if available (in case of a close match)\",\"nullable\":true,\"type\":\"string\"},\"result\":{\"description\":\"The result of the payee verification\",\"enum\":[\"Unknown\",\"Match\",\"NoMatch\",\"CloseMatch\"],\"type\":\"string\"}},\"type\":\"object\"},\"payeeVerificationStatus\":{\"description\":\"Current status of the payee verification check\",\"enum\":[\"None\",\"NotRequired\",\"Pending\",\"Completed\",\"Failed\",\"TimedOut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"documents\":{\"description\":\"Documents associated with the payout.\",\"items\":{\"additionalProperties\":false,\"description\":\"Used for returning a payout document.\",\"properties\":{\"amount\":{\"description\":\"Amount of the document, if applicable. Optional.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"currency\":{\"description\":\"Currency of the document, if applicable. Optional.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"description\":{\"description\":\"Additional information about the document. Optional.\",\"maxLength\":256,\"nullable\":true,\"type\":\"string\"},\"documentType\":{\"description\":\"Type of the document.\",\"enum\":[\"Other\",\"Invoice\",\"PurchaseOrder\"],\"type\":\"string\"},\"externalID\":{\"description\":\"Allows to associate an external ID to the document. Optional.\",\"maxLength\":128,\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Internal ID of the document.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Date of insertion.\",\"format\":\"date-time\",\"type\":\"string\"},\"title\":{\"description\":\"Used to identify the document.\",\"maxLength\":128,\"minLength\":1,\"type\":\"string\"}},\"required\":[\"documentType\",\"title\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"events\":{\"description\":\"The activity associated with the payout.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"errorReason\":{\"description\":\"Reason for the error, if any.\",\"nullable\":true,\"type\":\"string\"},\"eventType\":{\"description\":\"The event type.\",\"enum\":[\"Unknown\",\"Authorise\",\"Initiate\",\"Webhook\",\"Settle\",\"Failure\",\"Created\",\"Queued\",\"Scheduled\",\"BeneficiaryUpdated\",\"BeneficiaryDisabled\",\"Edited\",\"RejectedApproval\",\"TrustedAuthorise\",\"Signed\",\"BeneficiaryEnabled\",\"SubmitAttemptError\",\"PayeeVerificationInitiated\",\"PayeeVerificationComplete\",\"PayeeVerificationFailed\"],\"type\":\"string\"},\"payeeVerifiedAccountName\":{\"description\":\"If this event is a payee verification complete event and the result is a close match,\\r\\nthis contains the actual verified name returned by the payee verification supplier.\",\"nullable\":true,\"type\":\"string\"},\"payoutID\":{\"description\":\"The payout ID the event is for.\",\"format\":\"uuid\",\"type\":\"string\"},\"ruleName\":{\"description\":\"The name of the rule that triggered the event.\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"description\":\"Status of the payout.\",\"enum\":[\"UNKNOWN\",\"REJECTED\",\"PENDING\",\"PROCESSED\",\"PENDING_APPROVAL\",\"QUEUED_UPSTREAM\",\"QUEUED\",\"FAILED\",\"PENDING_INPUT\",\"SCHEDULED\",\"REJECTED_APPROVAL\"],\"type\":\"string\"},\"supplierPayeeVerificationResult\":{\"description\":\"If this event is a payee verification event, this contains the result of the verification.\",\"nullable\":true,\"type\":\"string\"},\"timestamp\":{\"description\":\"Event timestamp.\",\"format\":\"date-time\",\"type\":\"string\"},\"userID\":{\"description\":\"The user id of the user who the event is for.\",\"format\":\"uuid\",\"type\":\"string\"},\"userName\":{\"description\":\"The user name of the user who the event is for.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"formattedAmount\":{\"description\":\"Currency and formatted amount string.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"formattedFxDestinationAmount\":{\"description\":\"FX destination currency and amount formatted string.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"formattedSchedule\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"formattedScheduleDayOnly\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"formattedSourceAccountAvailableBalance\":{\"description\":\"The available balance of the account the payout is being made from.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"fxDestinationAmount\":{\"description\":\"If specified this will be the amount sent to the payee. The payout's Amount will be dynamically adjusted based on \\r\\nthis amount and the FX rate.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fxDestinationAmountMinorUnits\":{\"description\":\"The payout FxDestinationAmount expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"nullable\":true,\"readOnly\":true,\"type\":\"integer\"},\"fxDestinationCurrency\":{\"description\":\"For an FX payout this is the currency to send to the beneficiary.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"fxQuoteExpiresAt\":{\"description\":\"If an FX held rate quote ID is being used this is the time the quote expires.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"fxQuoteID\":{\"description\":\"Optional. For multi-currency payouts this is the ID of the held rate that was set for the FX conversion. If\\r\\nempty it indicates the mid-market FX rate is being be used.\",\"nullable\":true,\"type\":\"string\"},\"fxRate\":{\"description\":\"For an FX payout this is the exchange rate to use for the payout.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fxUseDestinationAmount\":{\"description\":\"For a multi-currency payout this indicates how the Amount and FxDestinationAmount are treated.\\r\\nIf true the FxDestinationAmount is authoritative and the Amount is set based on the FxRate. If false then the Amount is authoritative\\r\\nand the FxDestinationAmount is set based on the Amount and FxRate.\",\"type\":\"boolean\"},\"hasCurrentUserAuthorised\":{\"description\":\"True if the payout was loaded for a user and that user has already authorised the latest version of the payout.\",\"type\":\"boolean\"},\"id\":{\"description\":\"The ID for the payout.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"invoiceID\":{\"description\":\"Optional field to associate the payout with the invoice from an external \\r\\napplication such as Xero. The InvoiceID needs to be unique for each\\r\\naccount.\",\"nullable\":true,\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the payout is archived.\",\"type\":\"boolean\"},\"isFailed\":{\"description\":\"Set to true if a submitted payout subsequently fails. If a payout fails the amount is\\r\\nremvoed from the account's reserved balance.\",\"type\":\"boolean\"},\"isSettled\":{\"description\":\"Set to true if a payout was successfully processed and the corresponding transaction has been\\r\\nrecorded on the ledger.\",\"type\":\"boolean\"},\"isSubmitted\":{\"description\":\"Indicates whether the payout has been submitted for processing. Once submitted the payout\\r\\namount is reserved until the payout is marked as failed or settled.\",\"type\":\"boolean\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"merchantTokenDescription\":{\"nullable\":true,\"type\":\"string\"},\"nonce\":{\"nullable\":true,\"type\":\"string\"},\"paymentProcessor\":{\"description\":\"The usptream payment processor for the payout.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"paymentRail\":{\"description\":\"Optional field to indicate the payment rail to use for the payout. Currrently only\\r\\nsupports choosing between SEPA-CT and SEPA-INST for EUR payments. If not set, for a EUR\\r\\npayment, the default behaviour is to attempt SEPA-INST and fallback to SEPA-CT if rejected.\",\"enum\":[\"Default\",\"SEPA_CT\",\"SEPA_INST\",\"TARGET2\"],\"type\":\"string\"},\"payrunID\":{\"description\":\"The ID of the payrun that this payout is associated with.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"payrunName\":{\"description\":\"The name of the payrun that this payout is associated with.\",\"nullable\":true,\"type\":\"string\"},\"rule\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"scheduleDate\":{\"description\":\"The date the payout should be submitted.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"scheduled\":{\"description\":\"Should this payout be scheduled for a future date?\",\"nullable\":true,\"type\":\"boolean\"},\"sourceAccountAvailableBalance\":{\"description\":\"The available balance of the account the payout is being made from.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"sourceAccountAvailableBalanceMinorUnits\":{\"description\":\"The available balance of the source account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"nullable\":true,\"readOnly\":true,\"type\":\"integer\"},\"sourceAccountBic\":{\"description\":\"The BIC of the account the payout is being made from.\",\"nullable\":true,\"type\":\"string\"},\"sourceAccountCurrency\":{\"description\":\"The currency of the source account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"sourceAccountIban\":{\"description\":\"The IBAN of the account the payout is being made from.\",\"nullable\":true,\"type\":\"string\"},\"sourceAccountIdentifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"sourceAccountName\":{\"description\":\"The name of the account the payout is being made from.\",\"nullable\":true,\"type\":\"string\"},\"sourceAccountNumber\":{\"description\":\"The account number of the account the payout is being made from.\",\"nullable\":true,\"type\":\"string\"},\"sourceAccountSortcode\":{\"description\":\"The sort code of the account the payout is being made from.\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"description\":\"Gets or Sets the status of payout request\",\"enum\":[\"UNKNOWN\",\"REJECTED\",\"PENDING\",\"PROCESSED\",\"PENDING_APPROVAL\",\"QUEUED_UPSTREAM\",\"QUEUED\",\"FAILED\",\"PENDING_INPUT\",\"SCHEDULED\",\"REJECTED_APPROVAL\"],\"type\":\"string\"},\"tags\":{\"description\":\"An optional list of descriptive tags attached to the payout.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"colourHex\":{\"nullable\":true,\"type\":\"string\"},\"description\":{\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"merchantID\",\"name\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"theirReference\":{\"description\":\"Gets or Sets destination reference ID\",\"nullable\":true,\"type\":\"string\"},\"topupPayrunID\":{\"description\":\"The ID of a payrun that needs an account top up. \\r\\nPayouts can be used to top up payrun accounts.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"transactedAmount\":{\"description\":\"The actual amount debited from the account in NoFrixion.MoneyMoov.Models.Payout.Currency, as recorded on the settled\\r\\ntransaction. When NoFrixion.MoneyMoov.Models.Payout.FxUseDestinationAmount is `false` the debit amount was fixed\\r\\nat creation, so this should closely match NoFrixion.MoneyMoov.Models.Payout.Amount. When NoFrixion.MoneyMoov.Models.Payout.FxUseDestinationAmount\\r\\nis `true` the beneficiary's received amount was fixed, so this may differ from the estimated\\r\\nNoFrixion.MoneyMoov.Models.Payout.Amount due to rate movement between quote and settlement.\\r\\nNull for non-FX payouts and payouts with no settled transaction.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"transactedFxAmount\":{\"description\":\"The actual amount received by the beneficiary in NoFrixion.MoneyMoov.Models.Payout.FxDestinationCurrency, as recorded\\r\\non the settled transaction. When NoFrixion.MoneyMoov.Models.Payout.FxUseDestinationAmount is `true` the beneficiary's\\r\\nreceived amount was fixed at creation, so this should closely match NoFrixion.MoneyMoov.Models.Payout.FxDestinationAmount.\\r\\nWhen NoFrixion.MoneyMoov.Models.Payout.FxUseDestinationAmount is `false` the debit amount was fixed, so this may\\r\\ndiffer from the estimated NoFrixion.MoneyMoov.Models.Payout.FxDestinationAmount due to rate movement between quote and settlement.\\r\\nNull if the payout has no settled FX transaction.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"transactedFxRate\":{\"description\":\"The actual FX rate applied during settlement, as recorded on the associated transaction.\\r\\nNull if the payout has no settled FX transaction.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"type\":{\"description\":\"Gets or Sets payout type\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"type\":\"string\"},\"userID\":{\"description\":\"Gets or Sets User ID of who created the payout request\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"yourReference\":{\"description\":\"Gets or Sets your reference ID\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"payoutsCount\":{\"format\":\"int32\",\"type\":\"integer\"},\"scheduleDate\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"sourceAccounts\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountName\":{\"description\":\"Name for the account\",\"nullable\":true,\"type\":\"string\"},\"accountSupplierName\":{\"description\":\"The payment account supplier name. A payment account can be supplied by multiple payment processors.\",\"enum\":[\"None\",\"Cyber