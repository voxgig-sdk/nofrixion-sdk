      req: false
      short: "Optional."
      type: "`$STRING`"
    }
    {
      name: "isArchived"
      req: false
      short: "Indicates whether the merchant token is archived."
      type: "`$BOOLEAN`"
    }
    {
      name: "isEnabled"
      req: false
      short: "If set to false the merchant token will not be accepted to authorise a request."
      type: "`$BOOLEAN`"
    }
    {
      format: "date-time"
      name: "lastAuthorised"
      req: false
      type: "`$STRING`"
    }
