      short: "A list of authentication types allowed to authorise the merchant token."
      type: "`$ARRAY`"
    }
    {
      name: "authorisations"
      req: false
      short: "A list of users who have successfully authorised the latest version of the beneficiary."
      type: "`$ARRAY`"
    }
    {
      format: "int32"
      name: "authorisersCompletedCount"
      req: false
