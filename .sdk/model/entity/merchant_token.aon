  name: "merchant_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /api/v1/tokens"
            json: "{\"operationId\":\"CreateMerchantToken\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"description\":\"Token description\",\"minLength\":1,\"type\":\"string\"},\"hmacAlgorithm\":{\"description\":\"Optional shared secret algorithm to use for HMAC authentication. If set a shared secret will be \\r\\nreturned when the token is intially created but not on any subsequent retrievals.\",\"enum\":[\"None\",\"HMAC_SHA1\",\"HMAC_SHA256\",\"HMAC_SHA384\",\"HMAC_SHA512\"],\"type\":\"string\"},\"ipAddressWhitelist\":{\"description\":\"Optional. If set represents a comma separated list of IP addresses that this token is authorised to be used from.\\r\\nAttempts to use the token from an IP address not in the list will be rejected.\",\"nullable\":true,\"type\":\"string\"},\"merchantID\":{\"description\":\"The merchant id to add to the token\",\"format\":\"uuid\",\"type\":\"string\"},\"permissionTypes\":{\"description\":\"The list of permissions tho grant to the merchant token.\",\"items\":{\"enum\":[\"Deny\",\"CreatePaymentRequest\",\"EditPaymentRequest\",\"DeletePaymentRequest\",\"CreateRule\",\"EditRule\",\"DeleteRule\",\"CreatePayout\",\"EditPayout\",\"DeletePayout\",\"CreateReport\",\"EditReport\",\"DeleteReport\",\"ExecuteReport\",\"CreatePaymentAccount\",\"EditPaymentAccount\",\"TrustedSubmitPayout\",\"OpenBankingAccountInformation\",\"CreateDirectDebitMandate\",\"SubmitDirectDebitPayment\",\"ViewTransactions\",\"ViewPaymentAccount\",\"ViewPayout\",\"CreatePayrun\",\"ViewPayrun\",\"EditPayrun\",\"DeletePayrun\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"description\",\"merchantID\"],\"type\":\"object\"}}},\"description\":\"The details of the merchant token to add.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authenticationMethods\":{\"description\":\"A list of authentication types allowed to authorise the merchant token.\",\"items\":{\"enum\":[\"None\",\"WebAuthn\",\"OneTimePassword\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"authorisations\":{\"description\":\"A list of users who have successfully authorised the latest version of the beneficiary.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"authorisersCompletedCount\":{\"description\":\"The number of distinct authorisers that have authorised the merchant token.\",\"format\":\"int32\",\"type\":\"integer\"},\"authorisersRequiredCount\":{\"description\":\"The number of authorisers required for this merchant token. Is determined by business settings\\r\\non the source account and/or merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"canAuthorise\":{\"description\":\"True if the merchant token can be authorised by the user who loaded it.\",\"type\":\"boolean\"},\"description\":{\"nullable\":true,\"type\":\"string\"},\"expiresAt\":{\"description\":\"Optional. If set indicates the merchant token is not valid after the specified expiry date.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"hasCurrentUserAuthorised\":{\"description\":\"True if the beneficiary was loaded for a user and that user has already authorised the latest version of the beneficiary.\",\"type\":\"boolean\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"ipAddressWhitelist\":{\"description\":\"Optional. If set represents a comma separated list of IP addresses that this token is authorised to be used from.\\r\\nAttempts to use the token from an IP address not in the list will be rejected.\",\"nullable\":true,\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the merchant token is archived.\",\"type\":\"boolean\"},\"isEnabled\":{\"description\":\"If set to false the merchant token will not be accepted to authorise a request.\",\"type\":\"boolean\"},\"lastAuthorised\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"nonce\":{\"nullable\":true,\"type\":\"string\"},\"permissionTypes\":{\"description\":\"The permissions that the merchant token supports.\",\"items\":{\"enum\":[\"Deny\",\"CreatePaymentRequest\",\"EditPaymentRequest\",\"DeletePaymentRequest\",\"CreateRule\",\"EditRule\",\"DeleteRule\",\"CreatePayout\",\"EditPayout\",\"DeletePayout\",\"CreateReport\",\"EditReport\",\"DeleteReport\",\"ExecuteReport\",\"CreatePaymentAccount\",\"EditPaymentAccount\",\"TrustedSubmitPayout\",\"OpenBankingAccountInformation\",\"CreateDirectDebitMandate\",\"SubmitDirectDebitPayment\",\"ViewTransactions\",\"ViewPaymentAccount\",\"ViewPayout\",\"CreatePayrun\",\"ViewPayrun\",\"EditPayrun\",\"DeletePayrun\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"requestSignatureVersion\":{\"description\":\"Represent the version of the overall merchant token. This field is to allow the secret and public key mechanisms to\\r\\nvary over time. For example if the HTTP header fields to include in the algorithms change this version will faciliatate\\r\\nkeeping track of which signature versions a particular merchant token is using.\",\"format\":\"int32\",\"type\":\"integer\"},\"sharedSecretAlgorithm\":{\"description\":\"Optional shared secret algorithm to use for HMAC authentication.\",\"enum\":[\"None\",\"HMAC_SHA1\",\"HMAC_SHA256\",\"HMAC_SHA384\",\"HMAC_SHA512\"],\"type\":\"string\"},\"sharedSecretBase64\":{\"description\":\"The base 64 encoded shared secret that is used for request authentication with an HMAC.\\r\\nNote this property will ONLY be set when the token is initially created. It is not possible\\r\\nto retrieve the secret afterwards. If it is lost a new token should be created.\",\"nullable\":true,\"type\":\"string\"},\"token\":{\"description\":\"The JWT merchant token. It will only be available when the merchant token is\\r\\ninitially created. The token is not stored by NoFrixion.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"nonce\"],\"type\":\"object\"}},\"text/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authenticationMethods\":{\"description\":\"A list of authentication types allowed to authorise the merchant token.\",\"items\":{\"enum\":[\"None\",\"WebAuthn\",\"OneTimePassword\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"authorisations\":{\"description\":\"A list of users who have successfully authorised the latest version of the beneficiary.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"authorisersCompletedCount\":{\"description\":\"The number of distinct authorisers that have authorised the merchant token.\",\"format\":\"int32\",\"type\":\"integer\"},\"authorisersRequiredCount\":{\"description\":\"The number of authorisers required for this merchant token. Is determined by business settings\\r\\non the source account and/or merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"canAuthorise\":{\"description\":\"True if the merchant token can be authorised by the user who loaded it.\",\"type\":\"boolean\"},\"description\":{\"nullable\":true,\"type\":\"string\"},\"expiresAt\":{\"description\":\"Optional. If set indicates the merchant token is not valid after the specified expiry date.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"hasCurrentUserAuthorised\":{\"description\":\"True if the beneficiary was loaded for a user and that user has already authorised the latest version of the beneficiary.\",\"type\":\"boolean\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"ipAddressWhitelist\":{\"description\":\"Optional. If set represents a comma separated list of IP addresses that this token is authorised to be used from.\\r\\nAttempts to use the token from an IP address not in the list will be rejected.\",\"nullable\":true,\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the merchant token is archived.\",\"type\":\"boolean\"},\"isEnabled\":{\"description\":\"If set to false the merchant token will not be accepted to authorise a request.\",\"type\":\"boolean\"},\"lastAuthorised\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"nonce\":{\"nullable\":true,\"type\":\"string\"},\"permissionTypes\":{\"description\":\"The permissions that the merchant token supports.\",\"items\":{\"enum\":[\"Deny\",\"CreatePaymentRequest\",\"EditPaymentRequest\",\"DeletePaymentRequest\",\"CreateRule\",\"EditRule\",\"DeleteRule\",\"CreatePayout\",\"EditPayout\",\"DeletePayout\",\"CreateReport\",\"EditReport\",\"DeleteReport\",\"ExecuteReport\",\"CreatePaymentAccount\",\"EditPaymentAccount\",\"TrustedSubmitPayout\",\"OpenBankingAccountInformation\",\"CreateDirectDebitMandate\",\"SubmitDirectDebitPayment\",\"ViewTransactions\",\"ViewPaymentAccount\",\"ViewPayout\",\"CreatePayrun\",\"ViewPayrun\",\"EditPayrun\",\"DeletePayrun\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"requestSignatureVersion\":{\"description\":\"Represent the version of the overall merchant token. This field is to allow the secret and public key mechanisms to\\r\\nvary over time. For example if the HTTP header fields to include in the algorithms change this version will faciliatate\\r\\nkeeping track of which signature versions a particular merchant token is using.\",\"format\":\"int32\",\"type\":\"integer\"},\"sharedSecretAlgorithm\":{\"description\":\"Optional shared secret algorithm to use for HMAC authentication.\",\"enum\":[\"None\",\"HMAC_SHA1\",\"HMAC_SHA256\",\"HMAC_SHA384\",\"HMAC_SHA512\"],\"type\":\"string\"},\"sharedSecretBase64\":{\"description\":\"The base 64 encoded shared secret that is used for request authentication with an HMAC.\\r\\nNote this property will ONLY be set when the token is initially created. It is not possible\\r\\nto retrieve the secret afterwards. If it is lost a new token should be created.\",\"nullable\":true,\"type\":\"string\"},\"token\":{\"description\":\"The JWT merchant token. It will only be available when the merchant token is\\r\\ninitially created. The token is not stored by NoFrixion.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"nonce\"],\"type\":\"object\"}},\"text/plain\":{\"sch