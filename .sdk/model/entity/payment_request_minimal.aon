              }
            ]
          }
          contract: {
            id: "GET /api/v1/paymentrequests/{id}/minimal"
            json: "{\"operationId\":\"GetPaymentRequestMinimal\",\"parameters\":[{\"description\":\"The ID of the payment request to retrieve.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The amount of money to request.\",\"format\":\"double\",\"type\":\"number\"},\"amountPending\":{\"description\":\"The amount of money that was authorised but has not arrived in the account yet.\",\"format\":\"double\",\"type\":\"number\"},\"amountReceived\":{\"description\":\"The amount of money that has been received for this payment request.\",\"format\":\"double\",\"type\":\"number\"},\"amountRefunded\":{\"description\":\"The amount of money that has been refunded for this payment request.\",\"format\":\"double\",\"type\":\"number\"},\"callbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"cardStripePaymentIntentSecret\":{\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"The country code associated with the payment.\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency of the request.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"customFieldsToDisplay\":{\"description\":\"Custom fields to display to the customer.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"displayOnHostedPaymentPage\":{\"type\":\"boolean\"},\"displayOnPaymentReceipt\":{\"type\":\"boolean\"},\"displayOrder\":{\"format\":\"int32\",\"type\":\"integer\"},\"name\":{\"nullable\":true,\"type\":\"string\"},\"value\":{\"nullable\":true,\"type\":\"string\"}},\"required\":[\"name\",\"value\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"description\":{\"description\":\"An optional description for the payment request. If set this field will appear\\r\\non the transaction record for some card processors.\",\"nullable\":true,\"type\":\"string\"},\"dueDate\":{\"description\":\"The due date of the payment request.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"fieldDisplaySettings\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"displayOnHostedPaymentPage\":{\"description\":\"If false, the field will not be displayed on the hosted payment page.\",\"type\":\"boolean\"},\"displayOnPaymentReceipt\":{\"description\":\"If false, the field will not be displayed on the payment receipt.\",\"type\":\"boolean\"},\"field\":{\"description\":\"The field for which the display settings are defined.\",\"enum\":[\"None\",\"Description\",\"Customer\",\"DueDate\"],\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"googlePayMerchantID\":{\"description\":\"Merchant ID from Google Pay\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"jwk\":{\"description\":\"The jwk containing the public key\",\"nullable\":true,\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"merchantLogoUrlPng\":{\"nullable\":true,\"type\":\"string\"},\"merchantLogoUrlSvg\":{\"nullable\":true,\"type\":\"string\"},\"merchantName\":{\"nullable\":true,\"type\":\"string\"},\"merchantShortName\":{\"nullable\":true,\"type\":\"string\"},\"partialPaymentMethod\":{\"enum\":[\"None\",\"Partial\"],\"type\":\"string\"},\"paymentAttempts\":{\"description\":\"The payment attempts for this payment request.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"attemptKey\":{\"description\":\"For pay by bank attempts this is the ID that gets set on all the events (initiate,\\r\\ncallback, webhook and settlement) for the same attempt. For cards and lightning different\\r\\nfields are used to group payment request events.\",\"nullable\":true,\"type\":\"string\"},\"attemptedAmount\":{\"description\":\"The payment amount attempted.\",\"format\":\"double\",\"type\":\"number\"},\"authorisedAmount\":{\"description\":\"The payment amount that was authorised by the payer.\",\"format\":\"double\",\"type\":\"number\"},\"authorisedAt\":{\"description\":\"If the attempt was authorised this is the timestamp it occurred at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"captureAttempts\":{\"description\":\"The card capture attempts associated with this payment attempt.\",\"items\":{\"additionalProperties\":false,\"description\":\"Represents each individual payment capture attempt for a payment request.\",\"properties\":{\"captureFailedAt\":{\"description\":\"Date and time the capture failed.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"captureFailureError\":{\"description\":\"Capture failure reason.\",\"nullable\":true,\"type\":\"string\"},\"capturedAmount\":{\"description\":\"The amount that was captured.\",\"format\":\"double\",\"type\":\"number\"},\"capturedAt\":{\"description\":\"Date and time the capture was initiated.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"cardAuthoriseFailedAt\":{\"description\":\"If the card payment attempt was not succesfully authorised this is the timestamp\\r\\nit occurred at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"cardAuthorisedAmount\":{\"description\":\"The card payment amount that was authorised by the payer.\",\"format\":\"double\",\"type\":\"number\"},\"cardAuthorisedAt\":{\"description\":\"If the card payment attempt was authorised this is the timestamp it occurred at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"cardPayerAuthenticationSetupFailedAt\":{\"description\":\"If the card payment attempt authorisation was not succesfully set up\\r\\nthis is the timestamp it occurred at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The authorised payment currency.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"initiatedAt\":{\"description\":\"Timestamp the payment was initiated at.\",\"format\":\"date-time\",\"type\":\"string\"},\"institutionID\":{\"description\":\"Where available this is the ID of the institution used by the payer. For example in PIS attempts\\r\\nthis will be the ID of the bank the payer used for the attempt.\",\"nullable\":true,\"type\":\"string\"},\"institutionName\":{\"description\":\"Where available this is the name of the institution used by the payer. For example,\\r\\nin PIS attempts this will be the name of the bank the payer used for the attempt.\",\"nullable\":true,\"type\":\"string\"},\"isPaid\":{\"description\":\"True once the attempt has actually been paid (card authorised or settled).\",\"readOnly\":true,\"type\":\"boolean\"},\"paidAmount\":{\"description\":\"The amount that was actually paid.\",\"format\":\"double\",\"readOnly\":true,\"type\":\"number\"},\"paidAt\":{\"description\":\"The time the payment went through (card authorisation time or settlement time).\",\"format\":\"date-time\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"paymentMethod\":{\"description\":\"The payment type for the received money.\",\"enum\":[\"None\",\"card\",\"pisp\",\"lightning\",\"cardtoken\",\"applePay\",\"googlePay\",\"directDebit\"],\"type\":\"string\"},\"paymentProcessor\":{\"description\":\"The card processor that was used for the payment event.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"paymentRequestID\":{\"description\":\"The ID of the payment request the result is for.\",\"format\":\"uuid\",\"type\":\"string\"},\"pispAuthorisationFailedAt\":{\"description\":\"Timestamp for PSIP bank authorisation error or failure.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"reconciledTransactionID\":{\"description\":\"When the payment attempt is settled (only relevant for non-card payments) this is the payin transaction that\\r\\nthe payment request event was reconciled with.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"refundAttempts\":{\"description\":\"The refund attempts associated with this payment attempt.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"isCardVoid\":{\"type\":\"boolean\"},\"refundCancelledAmount\":{\"format\":\"double\",\"type\":\"number\"},\"refundCancelledAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"refundInitiatedAmount\":{\"format\":\"double\",\"type\":\"number\"},\"refundInitiatedAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"refundPayoutID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"refundSettledAmount\":{\"format\":\"double\",\"type\":\"number\"},\"refundSettledAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"settleFailedAt\":{\"description\":\"If the PISP attempt failed to settled after the expected settlement time this\\r\\nis the timestamp the failure was recorded at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"settledAmount\":{\"description\":\"The funds that were received from the payer.\",\"format\":\"double\",\"type\":\"number\"},\"settledAt\":{\"description\":\"If the PISP attempt was settled this is the timestamp it occurred at.\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"enum\":[\"None\",\"FullyPaid\",\"PartiallyPaid\",\"OverPaid\",\"Voided\",\"Authorized\"],\"readOnly\":true,\"type\":\"string\"},\"tokenisedCardID\":{\"description\":\"For card payments the merchant can request a reusable token for this payer and\\r\\nuse it to submit subsequent merchant initiated payments.\",\"nullable\":true,\"type\":\"string\"},\"walletName\":{\"enum\":[\"ApplePay\",\"GooglePay\"],\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"paymentMethodsList\":{\"description\":\"The payment methods that the payment request supports.\",\"items\":{\"enum\":[\"None\",\"card\",\"pisp\",\"lightning\",\"cardtoken\",\"applePay\",\"googlePay\",\"directDebit\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"paymentProcessor\":{\"description\":\"The card processor\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"paymentProcessorKey\":{\"description\":\"The card processors public key\",\"nullable\":true,\"type\":\"string\"},\"pispError\":{\"description\":\"This is the error returned from the bank which is recorded in payment request events.\",\"nullable\":true,\"type\":\"string\"},\"priorityBankID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"description\":\"The status of the payment request.\",\"enum\":[\"None\",\"FullyPaid\",\"PartiallyPaid\",\"OverPaid\",\"Voided\",\"Authorized\"],\"type\":\"string\"},\"stripeAccountID\":{\"description\":\"Account ID of connected customers in Stripe\",\"nullable\":true,\"type\":\"string\"},\"title\":{\"description\":\"The title of the payment request.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}},\"text/json\":{\"schema\":{\"additionalPropert