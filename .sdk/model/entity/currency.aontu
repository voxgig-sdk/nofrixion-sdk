# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      name: "code"
      req: false
      type: "`$STRING`"
    }
    {
      name: "decimals"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "isFiat"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "iso4217AlphaCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "iso4217NumericCode"
      req: false
      type: "`$STRING`"
    }
    {
      name: "symbol"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "currency"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "capability"
                orig: "capability"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/currencies"
          parts: [
            "api"
            "v1"
            "currencies"
          ]
          select: {
            exist: [
              "capability"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
