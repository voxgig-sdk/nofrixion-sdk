                name: "id"
                orig: "id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "PUT"
          orig: "/api/v1/accounts/{id}"
          parts: [
            "api"
            "v1"
            "accounts"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: {
              accountID: "`reqdata.account_id`"
              accountName: "`reqdata.account_name`"
            }
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "account"
      ]
      [
        "merchant"
      ]
      [
        "account"
        "topup"
      ]
    ]
  }



}
