r\\nIf an account receives a payment it will be automatically unarchived.\",\"type\":\"boolean\"},\"isConnectedAccount\":{\"description\":\"Indicates if the payment account is an externally connected account.\\r\\nExternally connected account can be used to view account balances and transactions.\",\"type\":\"boolean\"},\"isDefault\":{\"description\":\"Is the default account\",\"type\":\"boolean\"},\"isTrustAccount\":{\"description\":\"Indicates if the payment account is a trust account. The account name is displayed in the statement\\r\\ninstead of the merchant name for trust accounts.\",\"type\":\"boolean\"},\"isVirtual\":{\"description\":\"True if the account is a virtual account.\",\"readOnly\":true,\"type\":\"boolean\"},\"lastTransaction\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"date\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"lastUpdated\":{\"description\":\"Timestamp when the account was last updated.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"merchantName\":{\"description\":\"The name of the merchant that owns the account.\",\"nullable\":true,\"type\":\"string\"},\"physicalAccountID\":{\"description\":\"For virtual accounts this is the ID of the physical account that the virtual account is linked to.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"rules\":{\"description\":\"The list of rules associated with this account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"submittedPayoutsBalance\":{\"description\":\"Total of the payouts that have been submitted for processing.\",\"format\":\"double\",\"type\":\"number\"},\"submittedPayoutsBalanceMinorUnits\":