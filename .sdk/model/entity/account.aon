          contract: {
            id: "GET /api/v1/openbanking/accounts/{id}"
            json: "{\"operationId\":\"GetConnectedAccounts\",\"parameters\":[{\"description\":\"The ConsentTokenID is the reference id to the token.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountBalances\":{\"description\":\"The various balances for the account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"balanceAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"creditLineIncluded\":{\"description\":\"_Optional_. Indicates whether any credit lines are included in the balance.\",\"type\":\"boolean\"},\"creditLines\":{\"description\":\"_Optional_. Specifies the type of balance.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"creditLineAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"type\":{\"description\":\"Type of the credit line.\",\"enum\":[\"AVAILABLE\",\"CREDIT\",\"EMERGENCY\",\"PRE_AGREED\",\"TEMPORARY\",\"OTHER\",\"UNKNOWN\"],\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"dateTime\":{\"format\":\"date-time\",\"type\":\"string\"},\"type\":{\"enum\":[\"CLOSING_AVAILABLE\",\"CLOSING_BOOKED\",\"CLOSING_CLEARED\",\"EXPECTED\",\"FORWARD_AVAILABLE\",\"INFORMATION\",\"INTERIM_AV