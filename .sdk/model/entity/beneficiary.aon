            id: "GET /api/v1/merchants/{merchantID}/beneficiaries"
            json: "{\"operationId\":\"GetMerchantBeneficiaries\",\"parameters\":[{\"description\":\"The ID of the merchant to get the beneficiaries for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The page number from where records are retrieved.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of records to be retrieved from a page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The text filter used to retrieve the records..\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The currency filter used to retrieve the records..\",\"in\":\"query\",\"name\":\"currency\",\"schema\":{\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"}},{\"description\":\"If set to true will include disabled beneficiaries as well\",\"in\":\"query\",\"name\":\"includeDisabled\",\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"Optional expression to sort the order of the beneficiaries.\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional source account ID to filter beneficiaries by their source account.\",\"in\":\"query\",\"name\":\"sourceAccountID\",\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"approvalCallbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"authenticationMethods\":{\"description\":\"A list of authentication types 