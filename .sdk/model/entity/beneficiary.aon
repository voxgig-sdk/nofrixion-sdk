",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"merchantID\":{\"description\":\"Gets or Sets the merchant id.\",\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"description\":\"The descriptive name for the beneficiary.\",\"minLength\":1,\"type\":\"string\"},\"sourceAccountIDs\":{\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"theirReference\":{\"description\":\"Optional reference that will be used by default as TheirReference when creating payouts to this beneficiary \\r\\nif no TheirReference is specified for the payout.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"currency\",\"destination\",\"merchantID\",\"name\"],\"type\":\"object\"}}},\"description\":\"The beneficiary to create.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"approvalCallbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"authenticationMethods\":{\"description\":\"A list of authentication types allowed to authorise the payout.\",\"items\":{\"enum\":[\"None\",\"WebAuthn\",\"OneTimePassword\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"authorisations\":{\"description\":\"A list of users who have successfully authorised the latest version of the beneficiary.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"authorisersCompletedCount\":{\"description\":\"The number of distinct authorisers that have authorised the beneficiary.\",\"format\":\"int32\",\"type\":\"integer\"},\"authorisersRequiredCount\":{\"description\":\"The number of authorisers required for this beneficiary. Is determined by business settings\\r\\non the source account and/or merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"beneficiaryEvents\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"accountName\":{\"nullable\":true,\"type\":\"string\"},\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"nullable\":tru