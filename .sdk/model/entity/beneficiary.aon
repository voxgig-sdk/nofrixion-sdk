          contract: {
            id: "GET /api/v1/beneficiaries"
            json: "{\"operationId\":\"GetBeneficiaries\",\"parameters\":[{\"description\":\"Optional. The ID of the merchant to retrieve the beneficiaries for. \\r\\n            If not set beneficiaries for all merchants the user has access to will be returned\",\"in\":\"query\",\"name\":\"merchantID\",\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The page number from where records are retrieved.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of records to be retrieved from a page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The text filter used to retrieve the records.\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The currency filter used to retrieve the records..\",\"in\":\"query\",\"name\":\"currency\",\"schema\":{\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"}},{\"description\":\"If set to true will include disabled beneficiaries as well\",\"in\":\"query\",\"name\":\"includeDisabled\",\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"Optional expression to sort the order of the beneficiaries.\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional. The ID of the source account to filter beneficiaries by.\",\"in\":\"query\",\"name\":\"sourceAccountID\",\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"approvalCallbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"authenticationMethods\":{\"description\":\"A list of authentication types allowed to authorise the payout.\",\"items\":{\"enum\":[\"None\",\"WebAuthn\",\"OneTimePassword\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"authorisations\":{\"description\":\"A list of users who have successfully authorised the latest version of the beneficiary.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"},\"user\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"objec