:\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"hasCurrentUserAuthorised\":{\"description\":\"True if the beneficiary was loaded for a user and that user has already authorised the latest version of the beneficiary.\",\"type\":\"boolean\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"isEnabled\":{\"type\":\"boolean\"},\"lastAuthorised\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"Gets or Sets the merchant id.\",\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"description\":\"The descriptive name for the beneficiary.\",\"minLength\":1,\"type\":\"string\"},\"nonce\":{\"nullable\":true,\"type\":\"string\"},\"sourceAccounts\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountName\":{\"description\":\"Name for the account\",\"nullable\":true,\"type\":\"string\"},\"accountSupplierName\":{\"description\":\"The payment account supplier name. A payment account can be supplied by multiple payment processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"availableBalance\":{\"description\":\"The current available balance of the account. Calculated by subtracting any submitted payments from the current balance.\",\"format\":\"double\",\"readOnly\":true,\"type\":\"number\"},\"availableBalanceMinorUnits\":{\"description\":\"The available balance expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance of the account.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance of the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"bankName\":{\"description\":\"The bank name for external accounts\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the consent used to connect the external account.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"createdBy\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the client's default\\r\\nsession timeout will be used.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"merchantID\":{\"description\":\"The merchant ID for which the session timeout applies.\",\"format\":\"uuid\",\"type\":\"string\"},\"timeoutSeconds\":{\"description\":\"The number of seconds a session for this user should last before expiring.\",\"format\":\"int32\",\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"emailAddress\":{\"format\":\"email\",\"minLength\":1,\"type\":\"string\"},\"firstName\":{\"minLength\":1,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"lastName\":{\"minLength\":1,\"type\":\"string\"},\"passkeyAdded\":{\"type\":\"boolean\"},\"permissions\":{\"additionalProperties\":false,\"properties\":{\"merchantPermissions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountPermissions\":{\"additionalProperties\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"nullable\":true,\"type\":\"object\"},\"merchantID\":{\"nullable\":true,\"type\":\"string\"},\"permissions\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"merchantID\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"type\":\"object\"},\"rolesWithScope\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"assignedAt\":{\"description\":\"The date the role was assigned to the user on the merchant.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant the role is in.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleID\":{\"description\":\"The ID of the role the user has.\",\"format\":\"uuid\",\"type\":\"string\"},\"roleName\":{\"description\":\"The name of the role the user has.\",\"nullable\":true,\"type\":\"string\"},\"scope\":{\"description\":\"The number of accounts the user has access to in the merchant for the role.\",\"nullable\":true,\"type\":\"string\"},\"userID\":{\"description\":\"The ID of the user.\",\"format\":\"uuid\",\"type\":\"string\"}},\"required\":[\"assignedAt\",\"roleName\",\"scope\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"twoFactorEnabled\":{\"type\":\"boolean\"}},\"required\":[\"emailAddress\",\"firstName\",\"lastName\"],\"type\":\"object\"},\"createdByDisplayName\":{\"description\":\"Either the name of the user, merchant token or api key that created the account\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of the account in ISO 4217 format\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"defaultPaymentRail\":{\"description\":\"Indicates the default payment rail for this account. Normally it will be left as the\\r\\ndefault value but in some special cases it may be set to indicate payouts from this account\\r\\nshould be attempted with a specific payment rail.\",\"enum\":[\"Default\",\"SEPA_CT\",\"SEPA_INST\",\"TARGET2\"],\"type\":\"string\"},\"displayName\":{\"description\":\"Gets a unique display name for the payment account. Useful for when payment accounts need to \\r\\nbe listed.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"expiryDate\":{\"description\":\"The date that the external account will expire\",\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"externalAccountIcon\":{\"description\":\"The Icon for external accounts\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"Unique id for the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"inserted\":{\"description\":\"Timestamp when the account was created.\",\"format\":\"date-time\",\"type\":\"string\"},\"isArchived\":{\"description\":\"Indicates whether the account is archived. Archived accounts are not displayed in the UI.\\r\\nIf an account receives a payment it will be automatically unarchived.\",\"type\":\"boolean\"},\"isConnectedAccount\":{\"description\":\"Indicates if the payment account is an externally connected account.\\r\\nExternally connected account can be used to view account balances and transactions.\",\"type\":\"boolean\"},\"isDefault\":{\"description\":\"Is the default account\",\"type\":\"boolean\"},\"isTrustAccount\":{\"description\":\"Indicates if the payment account is a trust account. The account name is displayed in the statement\\r\\ninstead of the merchant name for trust accounts.\",\"type\":\"boolean\"},\"isVirtual\":{\"description\":\"True if the account is a virtual account.\",\"readOnly\":true,\"type\":\"boolean\"},\"lastTransaction\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"date\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"lastUpdated\":{\"description\":\"Timestamp when the account was last updated.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"merchantName\":{\"description\":\"The name of the merchant that owns the account.\",\"nullable\":true,\"type\":\"string\"},\"physicalAccountID\":{\"description\":\"For virtual accounts this is the ID of the physical account that the virtual account is linked to.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"rules\":{\"description\":\"The list of rules associated with this account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"submittedPayoutsBalance\":{\"description\":\"Total of the payouts that have been submitted for processing.\",\"format\":\"double\",\"type\":\"number\"},\"submittedPayoutsBalanceMinorUnits\":{\"description\":\"The balance of the submitted payouts expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"summary\":{\"description\":\"Gets a summary of the payments account's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"supplierSepaInstantStatus\":{\"description\":\"Indicates the status of the SEPA Instant payment rail for this account.\",\"enum\":[\"None\",\"Pending\",\"InProgress\",\"Enabled\",\"Disabled\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedConnectionStatus\":{\"description\":\"States the status of the Xero bank feed connection, if applicable.\",\"enum\":[\"None\",\"Pending\",\"Active\",\"Inactive\",\"Failed\"],\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedLastSyncedAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncLastFailedAt\":{\"format\":\"date-time\",\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncLastFailureReason\":{\"nullable\":true,\"type\":\"string\"},\"xeroBankFeedSyncStatus\":{\"enum\":[\"None\",\"InProgress\",\"Completed\",\"Failed\"],\"type\":\"string\"},\"xeroUnsynchronisedTransactionsCount\":{\"description\":\"Indicates the number of unsynchronised transactions with Xero\",\"format\":\"int32\",\"nullable\":true,\"type\":\"integer\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"theirReference\":{\"description\":\"The reference that will be used by default as TheirReference when creating payouts to this beneficiary\\r\\nif no TheirReference is specified for the payout.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"currency\",\"name\"],\"type\":\"object\"}}},\"description\":\"The beneficiary record.\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
