          contract: {
            id: "GET /api/v1/paymentrequests/card/customertokens/{merchantID}/{customerEmailAddress}"
            json: "{\"operationId\":\"GetTokenisedCardsForMerchant\",\"parameters\":[{\"description\":\"The ID of the merchant to get all customer card tokens for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The email address of the customer to retrieve the stored cards for.\",\"in\":\"path\",\"name\":\"customerEmailAddress\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"cardType\":{\"description\":\"The type of the tokenised card, e.g. Visa, MasterCard etc. It's possible this could\\r\\nbe empty if the card type could not be identified. There is no hard and fast way to\\r\\nknow for sure to know the type of card.\",\"nullable\":true,\"type\":\"string\"},\"customerEmailAddress\":{\"description\":\"When creating a tokenised card the payer's email address must be supplied. This is\\r\\nused as away to group card tokens for an end user. For customer initiated transactions \\r\\nit is important that the email address supplied has been verified to belong to the user\\r\\ninitiating the payment.\",\"format\":\"email\",\"nullable\":true,\"type\":\"string\"},\"expiryMonth\":{\"nullable\":true,\"type\":\"string\"},\"expiryYear\":{\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the card token that has been stored for the customer. This is \\r\\nthe ID to supply when requesting an authorisation on behalf of the customer.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"lastFourDigits\":{\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"maskedCardNumber\":{\"nullable\":true,\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"paymentRequestID\":{\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"text/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"cardType\":{\"description\":\"The type of the tokenised card, e.g. Visa, MasterCard etc. It's possible this could\\r\\nbe empty if the card type could not be identified. There is no hard and fast way to\\r\\nknow for sure to know the type of card.\",\"nullable\":true,\"type\":\"string\"},\"customerEmailAddress\":{\"description\":\"When creating a tokenised card the payer's email address must be supplied. This is\\r\\nused as away to group card tokens for an end user. For customer initiated transactions \\r\\nit is important that the email address supplied has been verified to belong to the user\\r\\ninitiating the payment.\",\"format\":\"email\",\"nullable\":true,\"type\":\"string\"},\"expiryMonth\":{\"nullable\":true,\"type\":\"string\"},\"expiryYear\":{\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the card token that has been stored for the customer. This is \\r\\nthe ID to supply when requesting an authorisation on behalf of the customer.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"lastFourDigits\":{\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"maskedCardNumber\":{\"nullable\":true,\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"paymentRequestID\":{\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"text/plain\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"cardType\":{\"description\":\"The type of the tokenised card, e.g. Visa, MasterCard etc. It's possible this could\\r\\nbe empty if the card type could not be identified. There is no hard and fast way to\\r\\nknow for sure to know the type of card.\",\"nullable\":true,\"type\":\"string\"},\"customerEmailAddress\":{\"description\":\"When creating a tokenised card the payer's email address must be supplied. This is\\r\\nused as away to group card tokens for an end user. For customer initiated transactions \\r\\nit is important that the email address supplied has been verified to belong to the user\\r\\ninitiating the payment.\",\"format\":\"email\",\"nullable\":true,\"type\":\"string\"},\"expiryMonth\":{\"nullable\":true,\"type\":\"string\"},\"expiryYear\":{\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the card token that has been stored for the customer. This is \\r\\nthe ID to supply when requesting an authorisation on behalf of the customer.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"lastFourDigits\":{\"nullable\":true,\"type\":\"string\"},\"lastUpdated\":{\"format\":\"date-time\",\"type\":\"string\"},\"maskedCardNumber\":{\"nullable\":true,\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"paymentRequestID\":{\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Returns a list of the tokenised cards that have been stored for the customer.\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
