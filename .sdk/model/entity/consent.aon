                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /api/v1/openbanking/consents/{merchantID}/{email}"
            json: "{\"operationId\":\"GetConsents\",\"parameters\":[{\"description\":\"The ID of the merchant to get the consents for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The email address of the end user to get the consents for.\",\"in\":\"path\",\"name\":\"email\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"callbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"nullable\":true,\"type\":\"string\"},\"expiryDate\":{\"format\":\"date-time\",\"type\":\"string\"},\"failureCallbackUrl\":{\"description\":\"Optional callback URL for open banking consent authorisation failure. \\r\\nIf the URL is set, the calling application will be redirected here with the error message.\\r\\nIf it’s not set it will fall back on default page that will show the error message.\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"institutionID\":{\"nullable\":true,\"type\":\"string\"},\"isEnabled\":{\"type\":\"boolean\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"provider\":{\"description\":\"Lists the supported card and PIS processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"successWebHookUrl\":{\"description\":\"A web hook URL to send an HTTP request to when the open banking consent\\r\\nis successfuly authorised. This web hook lets the calling application \\r\\nknow when a consent is ready to be used.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"text/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"callbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"nullable\":true,\"type\":\"string\"},\"expiryDate\":{\"format\":\"date-time\",\"type\":\"string\"},\"failureCallbackUrl\":{\"description\":\"Optional callback URL for open banking consent authorisation failure. \\r\\nIf the URL is set, the calling application will be redirected here with the error message.\\r\\nIf it’s not set it will fall back on default page that will show the error message.\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"institutionID\":{\"nullable\":true,\"type\":\"string\"},\"isEnabled\":{\"type\":\"boolean\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"provider\":{\"description\":\"Lists the supported card and PIS processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"successWebHookUrl\":{\"description\":\"A web hook URL to send an HTTP request to when the open banking consent\\r\\nis successfuly authorised. This web hook lets the calling application \\r\\nknow when a consent is ready to be used.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"text/plain\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"callbackUrl\":{\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"nullable\":true,\"type\":\"string\"},\"expiryDate\":{\"format\":\"date-time\",\"type\":\"string\"},\"failureCallbackUrl\":{\"description\":\"Optional callback URL for open banking consent authorisation failure. \\r\\nIf the URL is set, the calling application will be redirected here with the error message.\\r\\nIf it’s not set it will fall back on default page that will show the error message.\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"institutionID\":{\"nullable\":true,\"type\":\"string\"},\"isEnabled\":{\"type\":\"boolean\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"provider\":{\"description\":\"Lists the supported card and PIS processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"successWebHookUrl\":{\"description\":\"A web hook URL to send an HTTP request to when the open banking consent\\r\\nis successfuly authorised. This web hook lets the calling application \\r\\nknow when a consent is ready to be used.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"OK\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/api/v1/openbanking/consents/{merchantID}/{email}"
          rename: {
            param: {
              merchantID: "merchant_id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "openbanking"
            }
            {
              lit: "consents"
            }
            {
              var: "merchant_id"
            }
            {
              var: "email"
            }
          ]
          select: {
            exist: [
