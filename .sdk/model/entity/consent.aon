# Entity: consent

main: kit: entity: consent: {

  alias: field: {}

  fields: [
    {
      name: "authorisationUrl"
      req: false
      short: "The URL the authorising user needs to be redirected to in order to get the open banking consent token."
      type: "`$STRING`"
    }
    {
      name: "callbackUrl"
      req: false
      short: "Optional callback URL that the end user performing the open banking authorisation will be redirected to on completion."
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "consentID"
      req: false
      short: "The ID of the open banking consent."
      type: "`$STRING`"
    }
    {
      format: "email"
      name: "emailAddress"
      req: false
      short: "The email address that identifies the end user that will be authorising the open banking consent request."
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "expiryDate"
      req: false
      type: "`$STRING`"
    }
    {
      name: "failureCallbackUrl"
      req: false
      short: "Optional callback URL for open banking consent authorisation failure."
      type: "`$STRING`"
    }
    {
      format: "uuid"
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "inserted"
      req: false
      type: "`$STRING`"
    }
    {
      name: "institutionID"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The institution ID the open banking consent is being requested for."
      type: "`$STRING`"
    }
    {
      name: "isConnectedAccounts"
      req: false
      short: "Optional setting."
      type: "`$BOOLEAN`"
    }
    {
      name: "isEnabled"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      format: "uuid"
      name: "merchantID"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The ID of the merchant the consent token is being created to be used with."
      type: "`$STRING`"
    }
    {
      name: "provider"
      req: false
      short: "Lists the supported card and PIS processors."
      type: "`$STRING`"
    }
    {
      name: "successWebHookUrl"
      req: false
      short: "A web hook URL to send an HTTP request to when the open banking consent is successfuly authorised."
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "consent"
  op: {
    create: {
      name: "create"
      points: [
        {
          contract: {
            id: "POST /api/v1/openbanking/consents"
            json: "{\"operationId\":\"CreateConsent\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"callbackUrl\":{\"description\":\"Optional callback URL that the end user performing the open banking authorisation\\r\\nwill be redirected to on completion. Typically this should be a URL that takes the \\r\\nuser back to the application that they originally started the open banking authorisation\\r\\nfrom.\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"The email address that identifies the end user that will be authorising the \\r\\nopen banking consent request.\",\"format\":\"email\",\"nullable\":true,\"type\":\"string\"},\"failureCallbackUrl\":{\"description\":\"Optional URL for open banking consent authorisation failure. \\r\\nIf the URL is set, the calling application will be redirected here with the error\\r\\nmessage as query parameter. If it’s not set it will fall back on default page that\\r\\nwill show the error message.\",\"nullable\":true,\"type\":\"string\"},\"institutionID\":{\"description\":\"The institution ID the open banking consent is being requested for.\",\"minLength\":1,\"type\":\"string\"},\"isConnectedAccounts\":{\"description\":\"Optional setting. If connected accounts is enabled. After a successful consent authorisation,\\r\\nNoFrixion will pull all authorised EUR and GBP account information and store them along NoFrixion payment accounts.\",\"type\":\"boolean\"},\"merchantID\":{\"description\":\"The ID of the merchant the consent token is being created to be used with.\",\"format\":\"uuid\",\"type\":\"string\"},\"successWebHookUrl\":{\"description\":\"Optional URL that will be called by the MoneyMoov server upon a successful open banking\\r\\nauthorisation. The webhook URL will pass a single parameter of \\\"id\\\". That ID can\\r\\nthen be used in the MoneyMoov open banking actions to verify the operation. Note\\r\\nweb hooks can easily be spoofed and should NOT be trusted without calling back to the \\r\\nMoneyMoov server for verification.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"institutionID\",\"merchantID\"],\"type\":\"object\"}}},\"description\":\"The fields required to request a new consent. The email address must belong\\r\\n            to the user who will be authorising the consent.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authorisationUrl\":{\"description\":\"The URL the authorising user needs to be redirected to in order to get the open banking\\r\\nconsent token.\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the open banking consent. Once the consent has been authorised this\\r\\nis the ID that allows it to be utilised via the open banking APIs to list accounts,\\r\\ntransactions etc.\",\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"}},\"text/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authorisationUrl\":{\"description\":\"The URL the authorising user needs to be redirected to in order to get the open banking\\r\\nconsent token.\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the open banking consent. Once the consent has been authorised this\\r\\nis the ID that allows it to be utilised via the open banking APIs to list accounts,\\r\\ntransactions etc.\",\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"}},\"text/plain\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"authorisationUrl\":{\"description\":\"The URL the authorising user needs to be redirected to in order to get the open banking\\r\\nconsent token.\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the open banking consent. Once the consent has been authorised this\\r\\nis the ID that allows it to be utilised via the open banking APIs to list accounts,\\r\\ntransactions etc.\",\"format\":\"uuid\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"OK\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/api/v1/openbanking/consents"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "openbanking"
            }
            {
              lit: "consents"
            }
          ]
          transform: {
            req: {
              callbackUrl: "`reqdata.callback_url`"
              emailAddress: "`reqdata.email_address`"
              failureCallbackUrl: "`reqdata.failure_callback_url`"
              institutionID: "`reqdata.institution_id`"
              isConnectedAccounts: "`reqdata.is_connected_account`"
              merchantID: "`reqdata.merchant_id`"
              successWebHookUrl: "`reqdata.success_web_hook_url`"
            }
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "email"
                orig: "email"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
