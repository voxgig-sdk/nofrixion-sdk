          contract: {
            id: "GET /api/v1/merchants/paged"
            json: "{\"operationId\":\"GetMerchantsPaged\",\"parameters\":[{\"description\":\"Optional. The page number to retrieve.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"default\":1,\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"Optional. The number of merchants per page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"default\":10,\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The text filter to apply to retrieve merchants with a similar name, ID etc.\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional expression to sort the order of the merchants. Example \\\"Name desc,Inserted asc\\\".\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"includeSuspended\",\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountCurrencies\":{\"description\":\"The list of currencies that the merchant has accounts for.\",\"items\":{\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"canHaveTrustAccounts\":{\"description\":\"Trust accounts are a special type of account that allow the account name\\r\\nto be trusted for use in statements and verification of payee checks.\",\"type\":\"boolean\"},\"cardPaymentProcessor\":{\"description\":\"Name of the card payment processor. Can be \\\"Checkout\\\", \\\"Stripe\\\" or none.\",\"nullable\":true,\"type\":\"string\"},\"companyID\":{\"description\":\"The Company ID recorded in the Compliance system.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"displayQrOnHostedPay\":{\"description\":\"Indicates if a QR Code containing the payment link should be displayed\\r\\non the hosted payment page.\",\"type\":\"boolean\"},\"hostedPayVersion\":{\"description\":\"The version of the hosted payment page to use with the merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"id\":{\"description\":\"Unique ID for the merchant.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Timestamp the merchant was added to MoneyMoov.\",\"format\":\"date-time\",\"type\":\"string\"},\"isBlocked\":{\"description\":\"The merchant is blocked from making payments (payouts).\",\"type\":\"boolean\"},\"isExited\":{\"description\":\"The merchant has formally terminated their relationship\\r\\nand is no longer a customer.\",\"type\":\"boolean\"},\"isSuspended\":{\"description\":\"The merchant has temporarily suspended their own account.\\r\\nThis is a merchant-initiated action to temporarily pause services.\",\"type\":\"boolean\"},\"jurisdiction\":{\"description\":\"The jurisdiction the merchant entity is incorporated or established in.\",\"enum\":[\"IE\",\"UK\",\"EU\"],\"type\":\"string\"},\"logoUrlPng\":{\"description\":\"The CDN URL of the merchant's logo in PNG format.\",\"nullable\":true,\"type\":\"string\"},\"logoUrlSvg\":{\"description\":\"The CDN URL of the merchant's logo in SVG format.\",\"nullable\":true,\"type\":\"string\"},\"merchantCategoryCode\":{\"description\":\"The industry code that represents the merchant's primary trading activity.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The registered business name of the merchant.\",\"nullable\":true,\"type\":\"string\"},\"notes\":{\"description\":\"The notes field is an optional free text field that can be used to store any additional information about the merchant.\",\"nullable\":true,\"type\":\"string\"},\"parentMerchant\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\"