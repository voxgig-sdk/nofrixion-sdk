            json: "{\"operationId\":\"ExportMerchantPayouts\",\"parameters\":[{\"description\":\"Required. The ID of the merchant to get the payouts for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The page number from where records are retrieved.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of records to be retrieved from a page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"An optional status filter for the payout records.\",\"in\":\"query\",\"name\":\"statuses\",\"schema\":{\"items\":{\"description\":\"The status of payout.\",\"enum\":[\"UNKNOWN\",\"REJECTED\",\"PENDING\",\"PROCESSED\",\"PENDING_APPROVAL\",\"QUEUED_UPSTREAM\",\"QUEUED\",\"FAILED\",\"PENDING_INPUT\",\"SCHEDULED\",\"REJECTED_APPROVAL\"],\"type\":\"string\"},\"type\":\"array\"}},{\"description\":\"The date filter to apply to retrieve payouts created after this date.\",\"in\":\"query\",\"name\":\"fromDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The date filter to apply to retrieve payouts created up until this date.\",\"in\":\"query\",\"name\":\"toDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The text filter to apply to retrieve payouts with a similar title, description, merchant name or contact information.\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The currency filter to apply to retrieve payouts with this currency.\",\"in\":\"query\",\"name\":\"currency\",\"schema\":{\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"}},{\"description\":\"The amount filter to apply to retrieve payouts that exceed this amount.\",\"in\":\"query\",\"name\":\"minAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}},{\"description\":\"The amount filter to apply to retrieve payouts that don't exceed this amount.\",\"in\":\"query\",\"name\":\"maxAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}},{\"description\":\"The tag filter to apply to retrieve payouts with at least one of these tags.\",\"in\":\"query\",\"name\":\"tags\",\"schema\":{\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"}},{\"description\":\"Optional expression to sort the order of the payouts.\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"text/csv\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Returns a list of payout records as a CSV file.\"},\"202\":{\"description\":\"Accepted: The request to export payouts as csv has been accepted for processing but is not yet completed.\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
