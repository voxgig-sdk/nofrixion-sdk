    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "merchant_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "PUT /api/v1/merchants/{merchantID}"
            json: "{\"operationId\":\"UpdateMerchant\",\"parameters\":[{\"description\":\"The ID of the merchant to update.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"logoUrlPng\":{\"nullable\":true,\"type\":\"string\"},\"logoUrlSvg\":{\"nullable\":true,\"type\":\"string\"},\"notes\":{\"maxLength\":2000,\"nullable\":true,\"type\":\"string\"},\"paymentAccountLimit\":{\"format\":\"int32\",\"nullable\":true,\"type\":\"integer\"},\"shortName\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"The details to update for the merchant.\"},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"accountCurrencies\":{\"description\":\"The list of currencies that the merchant has accounts for.\",\"items\":{\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"canHaveTrustAccounts\":{\"description\":\"Trust accounts are a special type of account that allow the account name\\r\\nto be trusted for use in statements and verification of payee checks.\",\"type\":\"boolean\"},\"cardPaymentProcessor\":{\"description\":\"Name of the card payment processor. Can be \\\"Checkout\\\", \\\"Stripe\\\" or none.\",\"nullable\":true,\"type\":\"string\"},\"companyID\":{\"description\":\"The Company ID recorded in the Compliance system.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"displayQrOnHostedPay\":{\"description\":\"Indicates if a QR Code containing the payment link should be displayed\\r\\non the hosted payment page.\",\"type\":\"boolean\"},\"hostedPayVersion\":{\"description\":\"The version of the hosted payment page to use with the merchant.\",\"format\":\"int32\",\"type\":\"integer\"},\"id\":{\"description\":\"Unique ID for the merchant.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Timestamp the merchant was added to MoneyMoov.\",\"format\":\"date-time\",\"type\":\"string\"},\"isBlocked\":{\"description\":\"The merchant is blocked from making payments (payouts).\",\"type\":\"boolean\"},\"isExited\":{\"description\":\"The merchant has formally terminated their relationship\\r\\nand is no longer a customer.\",\"type\":\"boolean\"},\"isSuspended\":{\"description\":\"The merchant has temporarily suspended their own account.\\r\\nThis is a merchant-initiated action to temporarily pause services.\",\"type\":\"boolean\"},\"jurisdiction\":{\"description\":\"The jurisdiction the merchant entity is incorporated or established in.\",\"enum\":[\"IE\",\"UK\",\"EU\"],\"type\":\"string\"},\"logoUrlPng\":{\"description\":\"The CDN URL of the merchant's logo in PNG format.\",\"nullable\":true,\"type\":\"string\"},\"logoUrlSvg\":{\"description\":\"The CDN URL of the merchant's logo in SVG format.\",\"nullable\":true,\"type\":\"string\"},\"merchantCategoryCode\":{\"description\":\"The industry code that represents the merchant's primary trading activity.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The registered business name of the merchant.\",\"nullable\":true,\"type\":\"string\"},\"notes\":{\"description\":\"The notes field is an optional free text field that can be used to store any additional information about the merchant.\",\"nullable\":true,\"type\":\"string\"},\"parentMerchant\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"paymentAccountLimit\":{\"description\":\"The maximum number of payment accounts that can be created for the Merchant.\\r\\nTo increase the limit contact support.\",\"format\":\"int32\",\"type\":\"integer\"},\"paymentAccounts\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountName\":{\"description\":\"Name for the account\",\"nullable\":true,\"type\":\"string\"},\"accountSupplierName\":{\"description\":\"The payment account supplier name. A payment account can be supplied by multiple payment processors.\",\"enum\":[\"None\",\"CyberSource\",\"Checkout\",\"Stripe\",\"Modulr\",\"Plaid\",\"Yapily\",\"Nofrixion\",\"Bitcoin\",\"BitcoinTestnet\",\"BankingCircle\",\"BankingCircleAgency\",\"Simulator\",\"Lightning\",\"LightningTestnet\",\"BankingCircleDirectDebit\",\"Technoxander\"],\"type\":\"string\"},\"availableBalance\":{\"description\":\"The current available balance of the account. Calculated by subtracting any submitted payments from the current balance.\",\"format\":\"double\",\"readOnly\":true,\"type\":\"number\"},\"availableBalanceMinorUnits\":{\"description\":\"The available balance expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance of the account.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance of the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"bankName\":{\"description\":\"The bank name for external accounts\",\"nullable\":true,\"type\":\"string\"},\"consentID\":{\"description\":\"The ID of the consent used to connect the external account.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"createdBy\":{\"additionalProperties\":false,\"properties\":{\"clientSessionTimeouts\":{\"description\":\"The number of seconds a session for this user should last before expiring.\\r\\nThis is based on the user's role on the merchant.\\r\\nThis is used to set the session timeout in the client. If not set the 