# Entity: fx_rate

main: kit: entity: fx_rate: {

  alias: field: {}

  fields: [
    {
      name: "destinationCurrency"
      req: false
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "exchangeRate"
      req: false
      short: "The price at which the transaction will buy the source currency using the destination currency."
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "expiryTime"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "quoteID"
      req: false
      type: "`$STRING`"
    }
    {
      name: "sourceCurrency"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
    parts: [
      "source"
      "destination"
      "valid_for_minute"
    ]
    sep: "/"
  }

  name: "fx_rate"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "destination"
                orig: "destination"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "source"
                orig: "source"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/payouts/fxallheldrates/{source}/{destination}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "payouts"
            }
            {
              lit: "fxallheldrates"
            }
            {
              var: "source"
            }
            {
              var: "destination"
            }
          ]
          select: {
            exist: [
              "destination"
              "source"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "destination"
                orig: "destination"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "source"
                orig: "source"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "valid_for_minute"
                orig: "valid_for_minute"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/payouts/fxheldrate/{source}/{destination}/{validForMinutes}"
          rename: {
            param: {
              validForMinutes: "valid_for_minute"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "payouts"
            }
            {
              lit: "fxheldrate"
            }
            {
              var: "source"
            }
            {
              var: "destination"
            }
            {
              var: "valid_for_minute"
            }
          ]
          select: {
            exist: [
              "destination"
              "source"
              "valid_for_minute"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "fxallheldrate"
      ]
      [
        "fxheldrate"
      ]
    ]
  }



}
