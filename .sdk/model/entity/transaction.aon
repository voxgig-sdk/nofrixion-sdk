          }
          contract: {
            id: "GET /api/v1/accounts/{accountID}/transactions"
            json: "{\"operationId\":\"GetAccountTransactionsPaged\",\"parameters\":[{\"description\":\"The ID of the account to retrieve transactions for.\",\"in\":\"path\",\"name\":\"accountID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The start date to retrieve transactions from.\",\"in\":\"query\",\"name\":\"fromDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The page number to retrieve.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of transactions per page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"default\":20,\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The end date to retrieve transactions from.\",\"in\":\"query\",\"name\":\"toDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The type of transactions to retrieve from.\",\"in\":\"query\",\"name\":\"creditType\",\"schema\":{\"enum\":[\"All\",\"Payin\",\"Payout\"],\"type\":\"string\"}},{\"description\":\"The text filter to apply to retrieve transactions with a similar title, description, merchant name.\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional expression to sort the order of the transactions. Example \\\"Amount desc,Inserted asc\\\".\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The amount filter to apply to retrieve transactions that exceed this amount.\",\"in\":\"query\",\"name\":\"minAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}},{\"description\":\"The amount filter to apply to retrieve transactions that don't exceed this amount.\",\"in\":\"query\",\"name\":\"maxAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"The ID of the account the transaction belongs to.\",\"format\":\"uuid\",\"type\":\"string\"},\"accountName\":{\"description\":\"The name of the account the transaction belongs to.\",\"nullable\":true,\"type\":\"string\"},\"accountSequenceNumber\":{\"description\":\"The sequence number of transaction on a per account basis. This sequence number is guaranteed to be an arithemtic sequence \\r\\nnumber for all transactions belonging to the same account.\",\"format\":\"int32\",\"type\":\"integer\"},\"amount\":{\"description\":\"Amount of the transaction. Negative values indicate a pay out debit), positive\\r\\nvalues a pay in (credit).\",\"format\":\"double\",\"type\":\"number\"},\"amountMinorUnits\":{\"description\":\"Amount of the transaction expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance left on the account after the transaction.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance on the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"counterparty\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"An optional ID of an internal account the counterparty is associated with. If set\\r\\nit will take precedence over any other destination details set for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"description\":\"Address line 1 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"addressLine2\":{\"description\":\"Address line 2 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"beneficiaryID\":{\"description\":\"Optional ID of a Beneficiary to use for the counterparty destination. If set\\r\\nit will take precedence over any other destination details, except for AccountID,\\r\\nset for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"A country code for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"An email address for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"internalAccountName\":{\"description\":\"If the counterparty is an internal account, this is the name of the account.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"payeeVerificationResult\":{\"additionalProperties\":false,\"properties\":{\"payeeVerifiedAccountName\":{\"description\":\"The verified account name of the payee, if available (in case of a close match)\",\"nullable\":true,\"type\":\"string\"},\"result\":{\"description\":\"The result of the payee verification\",\"enum\":[\"Unknown\",\"Match\",\"NoMatch\",\"CloseMatch\"],\"type\":\"string\"}},\"type\":\"object\"},\"payeeVerificationStatus\":{\"description\":\"Current status of the payee verification check\",\"enum\":[\"None\",\"NotRequired\",\"Pending\",\"Completed\",\"Failed\",\"TimedOut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"counterpartySummary\":{\"description\":\"For pay in (credit) transactions this will contain a descriptive string with the \\r\\nmost important fields about the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of transaction.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"description\":{\"description\":\"Description of the transaction.\",\"nullable\":true,\"type\":\"string\"},\"fxAmount\":{\"description\":\"For an FX payout this is the amound in the FX currency.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fxCurrency\":{\"description\":\"For an FX payout this is the currency that was received or that was instructed.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"fxRate\":{\"description\":\"For an FX payout this is the exchange rate between the transaction currency and the FX currency.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"id\":{\"description\":\"Unique ID for the transaction.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Date when the transaction was inserted into the ledger.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"paymentRequestCustomFields\":{\"additionalProperties\":{\"nullable\":true,\"type\":\"string\"},\"description\":\"The custom fields that were attached to the payment request that resulted in this transaction.\",\"nullable\":true,\"type\":\"object\"},\"paymentRequestID\":{\"description\":\"For Pay by Bank and Direct Debit transactions this will contain the ID of the payment request.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"payoutID\":{\"description\":\"ID of the payout that resulted in the transaction.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"rawReference\":{\"description\":\"The raw payment reference details as received from the payment processor. For Banking Circle\\r\\ntransactions this contains the concatenated payment details fields from which the payment\\r\\nlifecycle ID can be derived.\",\"nullable\":true,\"type\":\"string\"},\"ruleID\":{\"description\":\"ID of the rule that resulted in the transaction.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"tags\":{\"description\":\"An optional list of descriptive tags attached to the transaction.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"colourHex\":{\"nullable\":true,\"type\":\"string\"},\"description\":{\"nullable\":true,\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"merchantID\":{\"format\":\"uuid\",\"type\":\"string\"},\"name\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"merchantID\",\"name\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"theirReference\":{\"description\":\"For a pay out the reference that the payer attached for the receiving party. For a\\r\\npay in this will typically be empty but for internal transactions may contain the\\r\\nreference the sending party set for themselves.\",\"nullable\":true,\"type\":\"string\"},\"transactionDate\":{\"description\":\"Date when the transaction occurred.\",\"format\":\"date-time\",\"type\":\"string\"},\"type\":{\"description\":\"Type of the transaction.\",\"enum\":[\"Internal\",\"SEPA_CT\",\"SEPA_INST\",\"UK_FAST\",\"UK_BACS\",\"Reversal\",\"BTC\",\"BTC_TEST\",\"LBTC\",\"LBTC_TEST\",\"SEPA_DD\",\"SEPA\",\"Unknown\",\"TARGET2\",\"SEPA_DD_REJECT\",\"CROSS_BORDER\",\"UK_CHAPS\"],\"type\":\"string\"},\"virtualIBAN\":{\"description\":\"If set it indicates the  payin was to a virtual IBAN.\",\"nullable\":true,\"type\":\"string\"},\"yourReference\":{\"description\":\"For a pay in the reference the sending party attached. For a pay out the \\r\\nreference that the payer attached for themselves.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"pageNumber\":{\"description\":\"Current page number. Its 1 based. i.e firstpage is 1, secondpage is 2\",\"format\":\"int32\",\"type\":\"integer\"},\"pageSize\":{\"description\":\"Page size\",\"format\":\"int32\",\"type\":\"integer\"},\"totalPages\":{\"description\":\"Total pages\",\"format\":\"int64\",\"type\":\"integer\"},\"totalSize\":{\"description\":\"Total count\",\"format\":\"int64\",\"type\":\"integer\"}},\"type\":\"object\"}},\"text/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"The ID of the account the transaction belongs to.\",\"format\":\"uuid\",\"type\":\"string\"},\"accountName\":{\"description\":\"The name of the account the transaction belongs to.\",\"nullable\":true,\"type\":\"string\"},\"accountSequenceNumber\":{\"description\":\"The sequence number of transaction on a per account basis. This sequence number is guaranteed to be an arithemtic sequence \\r\\nnumber for all transactions belonging to the same account.\",\"format\":\"int32\",\"type\":\"integer\"},\"amount\":{\"description\":\"Amount of the transaction. Negative values indicate a pay out debit), positive\\r\\nvalues a pay in (credit).\",\"format\":\"double\",\"type\":\"number\"},\"amountMinorUnits\":{\"description\":\"Amount of the transaction expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance left on the account after the transaction.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance on the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"counterparty\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"An optional ID of an internal account the counterparty is associated with. If set\\r\\nit will take precedence over any other destination details set for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"description\":\"Address line 1 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"addressLine2\":{\"description\":\"Address line 2 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"beneficiaryID\":{\"description\":\"Optional ID of a Beneficiary to use for the counterparty destination. If set\\r\\nit will take precedence over any other destination details, except for AccountID,\\r\\nset for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"A country code for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"An email address for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"internalAccountName\":{\"description\":\"If the counterparty is an internal account, this is the name of the account.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"payeeVerificationResult\":{\"additionalProperties\":false,\"properties\":{\"payeeVerifiedAccountName\":{\"description\":\"The verified account name of the payee, if available (in case of a close match)\",\"nullable\":true,\"type\":\"string\"},\"result\":{\"description\":\"The result of the payee verification\",\"enum\":[\"Unknown\",\"Match\",\"NoMatch\",\"CloseMatch\"],\"type\":\"string\"}},\"type\":\"object\"},\"payeeVerificationStatus\":{\"description\":\"Current status of the payee verification check\",\"enum\":[\"None\",\"NotRequired\",\"Pending\",\"Completed\",\"Failed\",\"TimedOut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"counterpartySummary\":{\"description\":\"For pay in (credit) transactions this will contain a descriptive string with the \\r\\nmost important fields about the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of transaction.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"description\":{\"description\":\"Description of the transaction.\",\"nullable\":true,\"type\":\"string\"},\"fxAmount\":{\"description\":\"For an FX payout this is the amound in the FX currency.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fxCurrency\":{\"description\":\"For an FX payout this is the currency that was received or that was instructed.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"nullable\":true,\"type\":\"string\"},\"fxRate\":{\"description\":\"For an FX payout this is the exchange rate between the transaction currency and the FX currency.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"id\":{\"description\":\"Unique ID for the transaction.\",\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"description\":\"Date when the transaction was inserted into the ledger.\",\"format\":\"date-time\",\"type\":\"string\"},\"merchantID\":{\"description\":\"The ID of the merchant that owns the account.\",\"format\":\"uuid\",\"type\":\"string\"},\"paymentRequestCustomFields\":{\"additionalProperties\":{\"nullable\":true,\"type\":\"string\"},\"description\":\"The custom fields that were attached to the payment request that resulted in this transaction.\",\"nullable\":true,\"type\":\"object\"},\"paymentRequestID\":{\"description\":\"For Pay by Bank and Direct Debit transactions this will contain the ID of the payment request.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"payoutID\":{\"description\":\"