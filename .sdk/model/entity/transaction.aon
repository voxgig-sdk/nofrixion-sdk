",\"STATEMENT\",\"UNKNOWN\"],\"type\":\"string\"},\"buildingNumber\":{\"default\":\"\",\"description\":\"The building number of the address.\",\"nullable\":true,\"type\":\"string\"},\"country\":{\"default\":\"\",\"description\":\"The 2-letter country code for the address. Institution's; may require you to specify the country when used in the context of the Payee to be able to make a payment.\",\"nullable\":true,\"type\":\"string\"},\"county\":{\"description\":\"The list of counties for the address.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"department\":{\"default\":\"\",\"description\":\"The department for the address.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"default\":\"\",\"description\":\"The post code of the address.\",\"nullable\":true,\"type\":\"string\"},\"streetName\":{\"default\":\"\",\"description\":\"The street name of the address.\",\"nullable\":true,\"type\":\"string\"},\"subDepartment\":{\"default\":\"\",\"description\":\"The sub-department for the address.\",\"nullable\":true,\"type\":\"string\"},\"townName\":{\"default\":\"\",\"description\":\"The town name of the address.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"merchantCategoryCode\":{\"default\":\"\",\"description\":\"The category code of the merchant in case the Payee is a business.\",\"nullable\":true,\"type\":\"string\"},\"merchantId\":{\"default\":\"\",\"description\":\"The merchant ID is a unique code provided by the payment processor to the merchant.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The account holder name of the beneficiary.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"accountIdentifications\",\"name\"],\"type\":\"object\"},\"payerDetails\":{\"additionalProperties\":false,\"properties\":{\"accountIdentifications\":{\"description\":\"The account identifications that identify the Payer; bank account.\",\"items\":{\"additionalProperties\":false,\"properties\":{\"identification\":{\"description\":\"The value associated with the account identification type.\",\"nullable\":true,\"type\":\"string\"},\"type\":{\"enum\":[\"SORT_CODE\",\"ACCOUNT_NUMBER\",\"IBAN\",\"BBAN\",\"BIC\",\"PAN\",\"MASKED_PAN\",\"MSISDN\",\"BSB\",\"NCC\",\"ABA\",\"ABA_WIRE\",\"ABA_ACH\",\"EMAIL\",\"ROLL_NUMBER\",\"BLZ\",\"IFS\",\"CLABE\",\"CTN\",\"BRANCH_CODE\"],\"type\":\"string\"}},\"required\":[\"identification\",\"type\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"address\":{\"additionalProperties\":false,\"properties\":{\"addressLines\":{\"description\":\"The address line of the address.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"addressType\":{\"description\":\"The type of the address.\",\"enum\":[\"BUSINESS\",\"CORRESPONDENCE\",\"DELIVERY_TO\",\"MAIL_TO\",\"PO_BOX\",\"POSTAL\",\"RESIDENTIAL\",\"STATEMENT\",\"UNKNOWN\"],\"type\":\"string\"},\"buildingNumber\":{\"default\":\"\",\"description\":\"The building number of the address.\",\"nullable\":true,\"type\":\"string\"},\"country\":{\"default\":\"\",\"description\":\"The 2-letter country code for the address. Institution's; may require you to specify the country when used in the context of the Payee to be able to make a payment.\",\"nullable\":true,\"type\":\"string\"},\"county\":{\"description\":\"The list of counties for the address.\",\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"department\":{\"default\":\"\",\"description\":\"The department for the address.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"default\":\"\",\"description\":\"The post code of the address.\",\"nullable\":true,\"type\":\"string\"},\"streetName\":{\"default\":\"\",\"description\":\"The street name of the address.\",\"nullable\":true,\"type\":\"string\"},\"subDepartment\":{\"default\":\"\",\"description\":\"The sub-department for the address.\",\"nullable\":true,\"type\":\"string\"},\"townName\":{\"default\":\"\",\"description\":\"The town name of the address.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"name\":{\"default\":\"\",\"description\":\"The account holder name of the Payer.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"accountIdentifications\"],\"type\":\"object\"},\"proprietaryBankTransactionCode\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"issuer\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"reference\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"statementReferences\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"value\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"status\":{\"enum\":[\"BOOKED\",\"PENDING\"],\"nullable\":true,\"type\":\"string\"},\"supplementaryData\":{\"nullable\":true},\"transactionAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"transactionInformation\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"transactionMutability\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"valueDateTime\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"OK\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
