          contract: {
            id: "GET /api/v1/openbanking/transactions/{id}/{accountID}"
            json: "{\"operationId\":\"GetConnectedAccountTransactions\",\"parameters\":[{\"description\":\"The ConsentTokenID is the reference id to the token.\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The id of the account where transactions are retrieved.\",\"in\":\"path\",\"name\":\"accountID\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional, offset the transactions by offset number.\",\"in\":\"query\",\"name\":\"offset\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"Optional, limit per amount of transactions.\",\"in\":\"query\",\"name\":\"limit\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"Optional, the date filter to apply to retrieve transactions created after this date.\",\"in\":\"query\",\"name\":\"transactionFrom\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Optional, the date filter to apply to retrieve transactions created up until this date.\",\"in\":\"query\",\"name\":\"transactionTo\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Default sort order is inserted descending (latest first). Set to true to sort by \\r\\n            inserted ascending (earliest first).\",\"in\":\"query\",\"name\":\"sortInsertedAscending\",\"schema\":{\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"addressDetails\":{\"additionalProperties\":false,\"properties\":{\"addressLine\":{\"default\":\"\",\"description\":\"Information, in free format text, that identifies a specific address.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"balance\":{\"additionalProperties\":false,\"description\":\"TransactionBalance\",\"properties\":{\"balanceAmount\":