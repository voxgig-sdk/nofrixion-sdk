          contract: {
            id: "GET /api/v1/merchants/{merchantID}/transactions"
            json: "{\"operationId\":\"GetMerchantTransactionsPaged\",\"parameters\":[{\"description\":\"The ID of the merchant to get transactions for.\",\"in\":\"path\",\"name\":\"merchantID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The page number from where records are retrieved. Note that the paging starts from page 1.\\r\\n            If a 0 is supplied it will be treated as a 1 and the first page is returned.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of records to be retrieved from a page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The date filter to apply to retrieve transactions added after this date.\",\"in\":\"query\",\"name\":\"fromDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The date filter to apply to retrieve transactions added up until this date.\",\"in\":\"query\",\"name\":\"toDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Flag to indicate whether to include transactions from child merchants.\",\"in\":\"query\",\"name\":\"includeChildMerchants\",\"schema\":{\"default\":false,\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"additionalProperties\":false,\"properties\":{\"content\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"The ID of the account the transaction belongs to.\",\"format\":\"uuid\",\"type\":\"string\"},\"accountName\":{\"description\":\"The name of the account the transaction belongs to.\",\"nullable\":true,\"type\":\"string\"},\"accountSequenceNumber\":{\"description\":\"The sequence number of transaction on a per account basis. This sequence number is guaranteed to be an arithemtic sequence \\r\\nnumber for all transactions belonging to the same account.\",\"format\":\"int32\",\"type\":\"integer\"},\"amount\":{\"description\":\"Amount of the transaction. Negative values indicate a pay out debit), positive\\r\\nvalues a pay in (credit).\",\"format\":\"double\",\"type\":\"number\"},\"amountMinorUnits\":{\"description\":\"Amount of the transaction expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"balance\":{\"description\":\"Balance left on the account after the transaction.\",\"format\":\"double\",\"type\":\"number\"},\"balanceMinorUnits\":{\"description\":\"Balance on the account expressed in the currency’s minor units (e.g. cents, pence).\",\"format\":\"int64\",\"readOnly\":true,\"type\":\"integer\"},\"counterparty\":{\"additionalProperties\":false,\"properties\":{\"accountID\":{\"description\":\"An optional ID of an internal account the counterparty is associated with. If set\\r\\nit will take precedence over any other destination details set for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"addressLine1\":{\"description\":\"Address line 1 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"addressLine2\":{\"description\":\"Address line 2 for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"beneficiaryID\":{\"description\":\"Optional ID of a Beneficiary to use for the counterparty destination. If set\\r\\nit will take precedence over any other destination details, except for AccountID,\\r\\nset for the counterparty.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"countryCode\":{\"description\":\"A country code for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins\",\"nullable\":true,\"type\":\"string\"},\"emailAddress\":{\"description\":\"An email address for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"identifier\":{\"additionalProperties\":false,\"properties\":{\"accountNumber\":{\"nullable\":true,\"type\":\"string\"},\"bic\":{\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"The currency for the account.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"displayBicSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displayScanSummary\":{\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"displaySummary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"iban\":{\"nullable\":true,\"type\":\"string\"},\"sortCode\":{\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Summary of the account identifier's most important properties.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"},\"type\":{\"description\":\"The type of the account identifier.\",\"enum\":[\"Unknown\",\"SCAN\",\"IBAN\",\"DD\",\"BTC\",\"BIC\"],\"readOnly\":true,\"type\":\"string\"}},\"required\":[\"currency\"],\"type\":\"object\"},\"internalAccountName\":{\"description\":\"If the counterparty is an internal account, this is the name of the account.\",\"nullable\":true,\"type\":\"string\"},\"name\":{\"description\":\"The name of the counterparty. For a person this should be their full name. For a \\r\\ncompany this should be their registered or trading name.\",\"nullable\":true,\"type\":\"string\"},\"payeeVerificationResult\":{\"additionalProperties\":false,\"properties\":{\"payeeVerifiedAccountName\":{\"description\":\"The verified account name of the payee, if available (in case of a close match)\",\"nullable\":true,\"type\":\"string\"},\"result\":{\"description\":\"The result of the payee verification\",\"enum\":[\"Unknown\",\"Match\",\"NoMatch\",\"CloseMatch\"],\"type\":\"string\"}},\"type\":\"object\"},\"payeeVerificationStatus\":{\"description\":\"Current status of the payee verification check\",\"enum\":[\"None\",\"NotRequired\",\"Pending\",\"Completed\",\"Failed\",\"TimedOut\"],\"type\":\"string\"},\"phoneNumber\":{\"description\":\"A phone number for the counterparty. Optional to set and depending on the payment\\r\\nnetwork does not always get set for pay ins.\",\"nullable\":true,\"type\":\"string\"},\"postCode\":{\"description\":\"Post code for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"postTown\":{\"description\":\"Post town for the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"summary\":{\"description\":\"Gets a convenient summary representation of the counterparty.\",\"nullable\":true,\"readOnly\":true,\"type\":\"string\"}},\"type\":\"object\"},\"counterpartySummary\":{\"description\":\"For pay in (credit) transactions this will contain a descriptive string with the \\r\\nmost important fields about the counterparty.\",\"nullable\":true,\"type\":\"string\"},\"currency\":{\"description\":\"Currency of transaction.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SEK\",\"SGD\",\"TRY\",\"ZAR\",\"BTC\"],\"type\":\"string\"},\"description\":{\"description\":\"Description of the transaction.\",\"nullable\":true,\"type\":\"string\"},\"fxAmount\":{\"description\":\"For an FX payout this is the amound in the FX currency.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fxCurrency\":{\"description\":\"For an FX payout this is the currency that was received or that was instructed.\",\"enum\":[\"NONE\",\"GBP\",\"EUR\",\"USD\",\"AUD\",\"BGN\",\"CAD\",\"CZK\",\"DKK\",\"HUF\",\"ISK\",\"CHF\",\"NOK\",\"PLN\",\"RON\",\"AED\",\"CNH\",\"HKD\",\"ILS\",\"JPY\",\"MXN\",\"NZD\",\"SAR\",\"SE