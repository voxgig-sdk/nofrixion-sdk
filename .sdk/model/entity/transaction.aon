            json: "{\"operationId\":\"ExportTransactionsForAccount\",\"parameters\":[{\"description\":\"The ID of the account to retrieve transactions for.\",\"in\":\"path\",\"name\":\"accountID\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}},{\"description\":\"The start date to retrieve transactions from.\",\"in\":\"query\",\"name\":\"fromDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"The page number to retrieve.\",\"in\":\"query\",\"name\":\"pageNumber\",\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The number of transactions per page.\",\"in\":\"query\",\"name\":\"pageSize\",\"schema\":{\"default\":20,\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"The end date to retrieve transactions from.\",\"in\":\"query\",\"name\":\"toDate\",\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"A credit filter to apply to the transactions to retrieve.\",\"in\":\"query\",\"name\":\"creditType\",\"schema\":{\"enum\":[\"All\",\"Payin\",\"Payout\"],\"type\":\"string\"}},{\"description\":\"The text filter to apply to retrieve transactions with a similar account name, description, their reference, your reference, etc.\",\"in\":\"query\",\"name\":\"search\",\"schema\":{\"type\":\"string\"}},{\"description\":\"Optional expression to sort the order of the transactions. Example \\\"Amount desc,Inserted asc\\\".\",\"in\":\"query\",\"name\":\"sort\",\"schema\":{\"type\":\"string\"}},{\"description\":\"The amount filter to apply to retrieve transactions that exceed this amount.\",\"in\":\"query\",\"name\":\"minAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}},{\"description\":\"The amount filter to apply to retrieve transactions that don't exceed this amount.\",\"in\":\"query\",\"name\":\"maxAmount\",\"schema\":{\"format\":\"double\",\"type\":\"number\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"text/csv\":{\"schema\":{\"format\":\"binary\",\"type\":\"string\"}}},\"description\":\"Returns the list of the transactions in a CSV file.\"},\"202\":{\"description\":\"Accepted. The CSV file is being generated.\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
