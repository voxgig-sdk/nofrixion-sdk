nBalance\",\"properties\":{\"balanceAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"type\":{\"enum\":[\"CLOSING_AVAILABLE\",\"CLOSING_BOOKED\",\"CLOSING_CLEARED\",\"EXPECTED\",\"FORWARD_AVAILABLE\",\"INFORMATION\",\"INTERIM_AVAILABLE\",\"INTERIM_BOOKED\",\"INTERIM_CLEARED\",\"OPENING_AVAILABLE\",\"OPENING_BOOKED\",\"OPENING_CLEARED\",\"PREVIOUSLY_CLOSED_BOOKED\",\"AUTHORISED\",\"OTHER\",\"UNKNOWN\"],\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"bookingDateTime\":{\"format\":\"date-time\",\"type\":\"string\"},\"chargeDetails\":{\"additionalProperties\":false,\"properties\":{\"chargeAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"}},\"type\":\"object\"},\"currency\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"currencyExchange\":{\"additionalProperties\":false,\"description\":\"Provides details on the currency exchange.\",\"properties\":{\"exchangeRate\":{\"description\":\"The factor used for conversion of an amount from one currency to another. This reflects the price at which one currency was \\r\\nbought with another currency.\",\"format\":\"double\",\"type\":\"number\"},\"sourceCurrency\":{\"default\":\"\",\"description\":\"Currency from which an amount is to be converted.\",\"nullable\":true,\"type\":\"string\"},\"targetCurrency\":{\"default\":\"\",\"description\":\"Currency to which an amount is to be converted.\",\"nullable\":true,\"type\":\"string\"},\"unitCurrency\":{\"default\":\"\",\"description\":\"The currency in which the rate of exchange is expressed in a currency exchange. In the example 1GBP the unit currency is GBP.\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"date\":{\"format\":\"date-time\",\"type\":\"string\"},\"description\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"enrichment\":{\"additionalProperties\":false,\"properties\":{\"categorisation\":{\"additionalProperties\":false,\"properties\":{\"categories\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"source\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"cleansedDescription\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"correctedDate\":{\"format\":\"date-time\",\"type\":\"string\"},\"location\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"merchant\":{\"additionalProperties\":false,\"properties\":{\"merchantName\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"parentGroup\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"},\"paymentProcessor\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"transactionHash\":{\"additionalProperties\":false,\"properties\":{\"hash\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"object\"},\"grossAmount\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"description\":\"The monetary value.\",\"format\":\"double\",\"type\":\"number\"},\"currency\":{\"description\":\"The [ISO 4217](https://www.xe.com/iso4217.php) currency code.\",\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"id\":{\"default\":\"\",\"nullable\":true,\"type\":\"string\"},\"isoBankTransactionCode\":{\"additionalProperties\":false,\"properties\":{\"domainCode\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"default\":\"\",\"nullable\":true,\"type\":