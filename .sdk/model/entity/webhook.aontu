# Entity: webhook

main: kit: entity: webhook: {

  alias: field: {}

  fields: [
    {
      name: "destinationUrl"
      req: false
      short: "The destination URL for the webhook."
      type: "`$STRING`"
    }
    {
      name: "emailAddress"
      req: false
      short: "The recipient email address(es) for notifications."
      type: "`$STRING`"
    }
    {
      name: "failedNotificationEmailAddress"
