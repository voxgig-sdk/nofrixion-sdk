s created for refund.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"status\":{\"nullable\":true,\"type\":\"string\"},\"walletName\":{\"enum\":[\"ApplePay\",\"GooglePay\"],\"nullable\":true,\"type\":\"string\"}},\"required\":[\"amount\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Returns a list of payment request event records.\"}},\"security\":[{\"Bearer\":[]}],\"securitySchemes\":{\"Bearer\":{\"description\":\"JWT Authorization header using the Bearer scheme.<br/>\\r\\n                      Enter your JWT access token in the text input below.<br/>\\r\\n                      Example: Bearer eyJhbGciOiJ...\",\"in\":\"header\",\"name\":\"Authorization\",\"type\":\"apiKey\"}},\"securitySource\":\"definition\"}"
