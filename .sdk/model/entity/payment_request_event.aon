.\",\"nullable\":true,\"type\":\"string\"},\"drirectDebitMandateID\":{\"description\":\"The ID of the mandate that was used wehn requesting payment.\",\"format\":\"uuid\",\"nullable\":true,\"type\":\"string\"},\"errorMessage\":{\"nullable\":true,\"type\":\"string\"},\"errorReason\":{\"nullable\":true,\"type\":\"string\"},\"eventType\":{\"enum\":[\"unknown\",\"card_payer_authentication_setup\",\"card_authorization\",\"card_sale\",\"card_capture\",\"card_void\",\"pisp_initiate\",\"pisp_callback\",\"lightning_invoice_created\",\"lightning_invoice_paid\",\"card_payer_authentication_failure\",\"pisp_webhook\",\"pisp_settle\",\"pisp_settle_failure\",\"pisp_refund_initiated\",\"pisp_refund_settled\",\"pisp_refund_cancelled\",\"card_webhook\",\"card_refund\",\"lightning_invoice_expired\",\"lightning_invoice_cancelled\",\"direct_debit_initiate\",\"direct_debit_create\",\"direct_debit_state_change\",\"direct_debit_paid\",\"direct_debit_failed\"],\"type\":\"string\"},\"id\":{\"format\":\"uuid\",\"type\":\"string\"},\"inserted\":{\"format\":\"date-time\",\"type\":\"string\"},\"lightningInvoice\":{\"description\":\"For Bitcoin Lightning payments this field holds the invoice presented to the payer.\",\"nullable\":true,\"type\":\"string\"},\"lightningRHash\":{\"description\":\"For Bitcoin Lightning payments the hash of the invoice presented to the payer.\",\"nullable\":true,\"type\":\"string\"},\"originUrl\":{\"description\":\"Optional field that can be set by payment methods, such as pay by bank, that may want to redirect\\r\\nback to the URL that initiated the attempt in the case of a failure condition.\",\"nullable\":true,\"type\":\"string\"},\"paymentMethodType\":{\"description\":\"The type of payment method the event relates to, e.g. card, pisp, etc.\",\"enum\":[\"None\",\"card\",\"pisp\",\"lightning\",\"cardtoken\",\"applePay\",\"googlePay\",\"directDebit\"],\"readOnly\":true,\"type\":\"string\"},\"paymentProcessorName\":{\"description\":\"If the event was for a card payment