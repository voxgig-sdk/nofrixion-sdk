      type: "`$STRING`"
    }
    {
      format: "int32"
      name: "cardExpiryMonth"
      req: false
      short: "For card payment events this field holds the payer's card expiry month."
      type: "`$INTEGER`"
    }
    {
      format: "int32"
      name: "cardExpiryYear"
      req: false
      short: "For card payment events this field holds the payer's card expiry year."
