  "requests": {
    "GET /api/v1/paymentrequests/{id}/events": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "GetPaymentRequestEvents",
        "parameters": [
          {
            "description": "ID of the payment request to get the events for.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
