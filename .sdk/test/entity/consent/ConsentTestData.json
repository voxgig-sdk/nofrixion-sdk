  "requests": {
    "POST /api/v1/openbanking/consents": {
      "provenance": "operation-contract",
      "contract": {
        "operationId": "CreateConsent",
        "parameters": [],
        "protocol": "http",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "callbackUrl": {
                    "description": "Optional callback URL that the end user performing the open banking authorisation\r\nwill be redirected to on completion. Typically this should be a URL that takes the \r\nuser back to the application that they originally started the open banking authorisation\r\nfrom.",
                    "nullable": true,
                    "type": "string"
                  },
                  "emailAddress": {
                    "description": "The email address that identifies the end user that will be authorising the \r\nopen banking consent request.",
                    "format": "email",
                    "nullable": true,
                    "type": "string"
                  },
                  "failureCallbackUrl": {
                    "description": "Optional URL for open banking consent authorisation failure. \r\nIf the URL is set, the calling application will be redirected here with the error\r\nmessage as query parameter. If it’s not set it will fall back on default page that\r\nwill show the error message.",
                    "nullable": true,
                    "type": "string"
                  },
                  "institutionID": {
                    "description": "The institution ID the open banking consent is being requested for.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "isConnectedAccounts": {
                    "description": "Optional setting. If connected accounts is enabled. After a successful consent authorisation,\r\nNoFrixion will pull all authorised EUR and GBP account information and store them along NoFrixion payment accounts.",
                    "type": "boolean"
                  },
                  "merchantID": {
                    "description": "The ID of the merchant the consent token is being created to be used with.",
                    "format": "uuid",
                    "type": "string"
                  },
                  "successWebHookUrl": {
                    "description": "Optional URL that will be called by the MoneyMoov server upon a successful open banking\r\nauthorisation. The webhook URL will pass a single parameter of \"id\". That ID can\r\nthen be used in the MoneyMoov open banking actions to verify the operation. Note\r\nweb hooks can easily be spoofed and should NOT be trusted without calling back to the \r\nMoneyMoov server for verification.",
                    "nullable": true,
                    "type": "string"
                  }
                },
                "required": [
                  "institutionID",
                  "merchantID"
                ],
                "type": "object"
              }
            }
          },
          "description": "The fields required to request a new consent. The email address must belong\r\n            to the user who will be authorising the consent."
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "authorisationUrl": {
                      "description": "The URL the authorising user needs to be redirected to in order to get the open banking\r\nconsent token.",
                      "nullable": true,
                      "type": "string"
                    },
                    "consentID": {
                      "description": "The ID of the open banking consent. Once the consent has been authorised this\r\nis the ID that allows it to be utilised via the open banking APIs to list accounts,\r\ntransactions etc.",
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "text/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "authorisationUrl": {
                      "description": "The URL the authorising user needs to be redirected to in order to get the open banking\r\nconsent token.",
                      "nullable": true,
                      "type": "string"
                    },
                    "consentID": {
                      "description": "The ID of the open banking consent. Once the consent has been authorised this\r\nis the ID that allows it to be utilised via the open banking APIs to list accounts,\r\ntransactions etc.",
                      "format": "uuid",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "text/plain": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "authorisationUrl": {
                      "description": "The URL the authorising user needs to be redirected to in order to get the open banking\r\nconsent token.",
                      "nullable": true,
