                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "securitySchemes": {
          "Bearer": {
            "description": "JWT Authorization header using the Bearer scheme.<br/>\r\n                      Enter your JWT access token in the text input below.<br/>\r\n                      Example: Bearer eyJhbGciOiJ...",
            "in": "header",
            "name": "Authorization",
            "type": "apiKey"
          }
        },
        "securitySource": "definition"
      }
